            : ui_cfg_c[0]==FX_EMPTY || is_dbl ? ( ui_modal_open=1; );
          ); ui_s+=1;
        );
        ui_sel_fx==FX_TUNER ? (
          sqrt(sqr(mx-185)+sqr(my-456))<=46 ? ( ui_cfg_sel[2]=ui_cfg_sel[2]<0.5?1.0:0.0; );
        ) : ui_n_params>0 ? (
          ui_kr=ui_n_params<=3?42:ui_n_params==4?38:32; ui_span=ui_n_params<=3?520:ui_n_params==4?610:720;
          ui_kstep=ui_n_params==1?0:ui_span/(ui_n_params-1); ui_kstart=480-ui_span*0.5; ui_k=0;
          loop(ui_n_params,
            ui_kcx=ui_kstart+ui_k*ui_kstep; ui_kcy=456;
            sqrt(sqr(mx-ui_kcx)+sqr(my-ui_kcy))<=ui_kr+10 ? (
