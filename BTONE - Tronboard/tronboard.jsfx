desc:BTONE - Tronboard (Multi-FX & Amp Modeler)
author:BTONE
version:1.0.0
tags:guitar multi-fx amp cab distortion overdrive modulation delay reverb tuner
options:no_meter want_all_kb

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R

slider1:0.5<0,1,0.001>-Master Input
slider2:0.5<0,1,0.001>-Master Output
slider3:0<0,1,1>-Global Bypass

@init
ext_noinit = 1;

MEM_MAGIC_VAL=88776699;
SLOT_CFG_BASE=100; SLOT_CFG_STRIDE=16;
USER_PRESET_BASE=500;
SLOT_DSP_BASE=2000; SLOT_DSP_STRIDE=256;
SLOT_BUF_BASE=10000; SLOT_BUF_STRIDE=140000;

FX_EMPTY=0;
FX_COMP=1; FX_GATE=2; FX_AUTOWAH=3; FX_CRYWAH=4; FX_TUNER=5; FX_OCTAVER=6;
FX_BOOSTER=7; FX_TS808=8; FX_KLON=9; FX_BLUESDRV=10; FX_SUPEROD=11;
FX_DIST=12; FX_RAT=13; FX_FUZZ=14; FX_MUFF=15; FX_73DRIVE=16;
FX_AMP_FENDER=17; FX_AMP_BASSMAN=18; FX_AMP_TWEED=19; FX_AMP_VOX=20; FX_AMP_PLEXI=21;
FX_AMP_JCM800=22; FX_AMP_ORANGE=23; FX_AMP_MESA=24; FX_AMP_5150=25; FX_AMP_JC120=26;
FX_CAB_112BF=27; FX_CAB_212AC=28; FX_CAB_410TW=29; FX_CAB_412GB=30; FX_CAB_412V30=31;
FX_EQ5=32; FX_PARAEQ=33; FX_CHORUS=34; FX_FLANGER=35; FX_PHASER=36; FX_TREMOLO=37; FX_ROTARY=38;
FX_DELAY=39; FX_ANALOG_DLY=40; FX_TAPE_ECHO=41; FX_SPACE_ECHO=42;
FX_REV_HALL=43; FX_REV_PLATE=44; FX_REV_SPRING=45; FX_REV_SHIMMER=46;

function clamp(v, lo, hi) ( v < lo ? lo : (v > hi ? hi : v); );
function soft_tanh(x) local(x2) ( x=clamp(x,-4.5,4.5); x2=x*x; x*(27+x2)/(27+9*x2); );
function db2lin(db) ( exp(db * 0.11512925464970229); );

function bq_set_lp(base, freq, q) local(sr, w0, cs, sn, alpha, a0, b0) (
  sr=max(srate,44100); freq=clamp(freq,20,sr*0.45); q=max(q,0.2);
  w0=2*$pi*freq/sr; cs=cos(w0); sn=sin(w0); alpha=sn/(2*q); a0=1+alpha;
  b0=(1-cs)*0.5/a0; base[0]=b0; base[1]=(1-cs)/a0; base[2]=b0; base[3]=(-2*cs)/a0; base[4]=(1-alpha)/a0;
);
function bq_set_hp(base, freq, q) local(sr, w0, cs, sn, alpha, a0, b0) (
  sr=max(srate,44100); freq=clamp(freq,20,sr*0.45); q=max(q,0.2);
  w0=2*$pi*freq/sr; cs=cos(w0); sn=sin(w0); alpha=sn/(2*q); a0=1+alpha;
  b0=(1+cs)*0.5/a0; base[0]=b0; base[1]=-(1+cs)/a0; base[2]=b0; base[3]=(-2*cs)/a0; base[4]=(1-alpha)/a0;
);
function bq_set_bp(base, freq, q) local(sr, w0, cs, sn, alpha, a0) (
  sr=max(srate,44100); freq=clamp(freq,30,sr*0.45); q=max(q,0.25);
  w0=2*$pi*freq/sr; cs=cos(w0); sn=sin(w0); alpha=sn/(2*q); a0=1+alpha;
  base[0]=alpha/a0; base[1]=0; base[2]=-alpha/a0; base[3]=(-2*cs)/a0; base[4]=(1-alpha)/a0;
);
function bq_set_peak(base, freq, q, db) local(sr, A, w0, cs, sn, alpha, a0) (
  sr=max(srate,44100); freq=clamp(freq,20,sr*0.45); q=max(q,0.2);
  A=exp(db*0.05756462732485114); w0=2*$pi*freq/sr; cs=cos(w0); sn=sin(w0); alpha=sn/(2*q); a0=1+alpha/A;
  base[0]=(1+alpha*A)/a0; base[1]=(-2*cs)/a0; base[2]=(1-alpha*A)/a0; base[3]=(-2*cs)/a0; base[4]=(1-alpha/A)/a0;
);
function bq_set_lshelf(base, freq, q, db) local(sr, A, w0, cs, sn, alpha, sq, a0) (
  sr=max(srate,44100); freq=clamp(freq,20,sr*0.45);
  A=exp(db*0.05756462732485114); w0=2*$pi*freq/sr; cs=cos(w0); sn=sin(w0); alpha=sn/(2*max(q,0.3)); sq=2*sqrt(A)*alpha;
  a0=(A+1)+(A-1)*cs+sq;
  base[0]=(A*((A+1)-(A-1)*cs+sq))/a0; base[1]=(2*A*((A-1)-(A+1)*cs))/a0; base[2]=(A*((A+1)-(A-1)*cs-sq))/a0;
  base[3]=(-2*((A-1)+(A+1)*cs))/a0; base[4]=((A+1)+(A-1)*cs-sq)/a0;
);
function bq_set_hshelf(base, freq, q, db) local(sr, A, w0, cs, sn, alpha, sq, a0) (
  sr=max(srate,44100); freq=clamp(freq,20,sr*0.45);
  A=exp(db*0.05756462732485114); w0=2*$pi*freq/sr; cs=cos(w0); sn=sin(w0); alpha=sn/(2*max(q,0.3)); sq=2*sqrt(A)*alpha;
  a0=(A+1)-(A-1)*cs+sq;
  base[0]=(A*((A+1)+(A-1)*cs+sq))/a0; base[1]=(-2*A*((A-1)+(A+1)*cs))/a0; base[2]=(A*((A+1)+(A-1)*cs-sq))/a0;
  base[3]=(2*((A-1)-(A+1)*cs))/a0; base[4]=((A+1)-(A-1)*cs-sq)/a0;
);
function bq_proc_L(base, x) local(y) (
  x = x + 0.000000000000001;
  y=base[0]*x+base[5]; base[5]=base[1]*x-base[3]*y+base[6]; base[6]=base[2]*x-base[4]*y;
  base[5] = (base[5] > -0.000000000000001 && base[5] < 0.000000000000001) ? 0.0 : base[5];
  base[6] = (base[6] > -0.000000000000001 && base[6] < 0.000000000000001) ? 0.0 : base[6];
  y;
);
function bq_proc_R(base, x) local(y) (
  x = x + 0.000000000000001;
  y=base[0]*x+base[7]; base[7]=base[1]*x-base[3]*y+base[8]; base[8]=base[2]*x-base[4]*y;
  base[7] = (base[7] > -0.000000000000001 && base[7] < 0.000000000000001) ? 0.0 : base[7];
  base[8] = (base[8] > -0.000000000000001 && base[8] < 0.000000000000001) ? 0.0 : base[8];
  y;
);

function clear_slot_dsp(s) local(dsp, buf, bi) (
  dsp = SLOT_DSP_BASE + s * SLOT_DSP_STRIDE;
  memset(dsp, 0, SLOT_DSP_STRIDE);
  // Set unity passthrough on all 6 biquads as safe default
  bi = 0; loop(6, dsp[bi * 10] = 1.0; bi += 1;);
  // Zero modulation/delay/reverb state indices (60-149) so old FX state
  // does not leak into a newly loaded effect in the same slot
  bi = 60; loop(90, dsp[bi] = 0.0; bi += 1;);
  buf = SLOT_BUF_BASE + s * SLOT_BUF_STRIDE;
  memset(buf, 0, SLOT_BUF_STRIDE);
);

function set_slot_fx(s, fx_id) local(cfg) (
  cfg = SLOT_CFG_BASE + s * SLOT_CFG_STRIDE;
  cfg[0]=fx_id; cfg[1]=0; cfg[2]=0.5; cfg[3]=0.5; cfg[4]=0.5; cfg[5]=0.5; cfg[6]=0.5; cfg[7]=0.5;
  fx_id==FX_COMP ? ( cfg[2]=0.45; cfg[3]=0.45; cfg[4]=0.25; cfg[5]=0.45; cfg[6]=0.55; cfg[7]=1.0; );
  fx_id==FX_GATE ? ( cfg[2]=0.25; cfg[3]=0.15; cfg[4]=0.35; cfg[5]=0.85; );
  fx_id==FX_AUTOWAH ? ( cfg[2]=0.60; cfg[3]=0.55; cfg[4]=0.50; cfg[5]=0.85; );
  fx_id==FX_CRYWAH ? ( cfg[2]=0.50; cfg[3]=0.60; cfg[4]=0.55; cfg[5]=0.90; );
  fx_id==FX_TUNER ? ( cfg[2]=0.0; );
  fx_id==FX_OCTAVER ? ( cfg[2]=0.60; cfg[3]=0.35; cfg[4]=0.75; cfg[5]=0.55; );
  fx_id==FX_BOOSTER ? ( cfg[2]=0.55; cfg[3]=0.55; cfg[4]=0.40; );
  (fx_id>=FX_TS808 && fx_id<=FX_SUPEROD) ? ( cfg[2]=0.48; cfg[3]=0.56; cfg[4]=0.60; );
  (fx_id==FX_DIST || fx_id==FX_RAT) ? ( cfg[2]=0.60; cfg[3]=0.48; cfg[4]=0.56; );
  fx_id==FX_FUZZ ? ( cfg[2]=0.68; cfg[3]=0.50; cfg[4]=0.50; cfg[5]=0.55; );
  fx_id==FX_MUFF ? ( cfg[2]=0.70; cfg[3]=0.55; cfg[4]=0.40; cfg[5]=0.55; );
  fx_id==FX_73DRIVE ? ( cfg[2]=0.48; cfg[3]=0.50; cfg[4]=0.60; cfg[5]=0.50; cfg[6]=0.30; cfg[7]=0.50; );
  (fx_id>=FX_AMP_FENDER && fx_id<=FX_AMP_JC120) ? ( cfg[2]=0.48; cfg[3]=0.52; cfg[4]=0.54; cfg[5]=0.62; cfg[6]=0.56; cfg[7]=0.60; );
  fx_id==FX_AMP_MESA || fx_id==FX_AMP_5150 ? ( cfg[2]=0.72; cfg[4]=0.45; cfg[5]=0.65; );
  fx_id==FX_AMP_JC120 ? ( cfg[2]=0.22; cfg[7]=0.68; );
  (fx_id>=FX_CAB_112BF && fx_id<=FX_CAB_412V30) ? ( cfg[2]=0.55; cfg[3]=0.50; cfg[4]=0.45; cfg[5]=0.65; );
  fx_id==FX_EQ5 ? ( cfg[2]=0.52; cfg[3]=0.46; cfg[4]=0.55; cfg[5]=0.58; cfg[6]=0.52; cfg[7]=0.50; );
  fx_id==FX_PARAEQ ? ( cfg[2]=0.18; cfg[3]=0.75; cfg[4]=0.52; cfg[5]=0.48; cfg[6]=0.55; cfg[7]=0.50; );
  fx_id==FX_CHORUS ? ( cfg[2]=0.35; cfg[3]=0.68; cfg[4]=0.68; cfg[5]=0.65; );
  fx_id==FX_FLANGER ? ( cfg[2]=0.30; cfg[3]=0.72; cfg[4]=0.74; cfg[5]=0.65; );
  fx_id==FX_PHASER ? ( cfg[2]=0.32; cfg[3]=0.75; cfg[4]=0.62; cfg[5]=0.75; );
  fx_id==FX_TREMOLO ? ( cfg[2]=0.42; cfg[3]=0.78; cfg[4]=0.35; cfg[5]=0.50; );
  fx_id==FX_ROTARY ? ( cfg[2]=0.38; cfg[3]=0.68; cfg[4]=0.55; cfg[5]=0.30; cfg[6]=0.85; );
  fx_id==FX_DELAY ? ( cfg[2]=0.40; cfg[3]=0.48; cfg[4]=0.68; cfg[5]=0.20; cfg[6]=0.45; cfg[7]=0.45; );
  fx_id==FX_ANALOG_DLY ? ( cfg[2]=0.42; cfg[3]=0.52; cfg[4]=0.55; cfg[5]=0.35; cfg[6]=0.30; cfg[7]=0.48; );
  fx_id==FX_TAPE_ECHO ? ( cfg[2]=0.45; cfg[3]=0.54; cfg[4]=0.40; cfg[5]=0.45; cfg[6]=0.40; cfg[7]=0.48; );
  fx_id==FX_SPACE_ECHO ? ( cfg[2]=0.44; cfg[3]=0.56; cfg[4]=0.68; cfg[5]=0.38; cfg[6]=0.35; cfg[7]=0.50; );
  fx_id==FX_REV_HALL ? ( cfg[2]=0.58; cfg[3]=0.22; cfg[4]=0.35; cfg[5]=0.62; cfg[6]=0.25; cfg[7]=0.45; );
  fx_id==FX_REV_PLATE ? ( cfg[2]=0.55; cfg[3]=0.05; cfg[4]=0.25; cfg[5]=0.75; cfg[6]=0.40; cfg[7]=0.45; );
  fx_id==FX_REV_SPRING ? ( cfg[2]=0.48; cfg[3]=0.12; cfg[4]=0.35; cfg[5]=0.58; cfg[6]=0.55; cfg[7]=0.45; );
  fx_id==FX_REV_SHIMMER ? ( cfg[2]=0.76; cfg[3]=0.30; cfg[4]=0.32; cfg[5]=0.72; cfg[6]=0.60; cfg[7]=0.50; );
  clear_slot_dsp(s);
);

function clear_all_slots() local(s) ( s=0; loop(12, set_slot_fx(s, FX_EMPTY); s+=1;); );

function load_preset(idx) local(cfg, u, ubase, s) (
  cur_preset = clamp(idx, 0, 9);
  clear_all_slots();
  u = cur_preset;
  ubase = USER_PRESET_BASE + u * 128;
  ubase[120] == 1 ? (
    s = 0;
    loop(12,
      cfg = SLOT_CFG_BASE + s * SLOT_CFG_STRIDE;
      cfg[0] = ubase[s*8]; cfg[1] = ubase[s*8+1]; cfg[2] = ubase[s*8+2]; cfg[3] = ubase[s*8+3];
      cfg[4] = ubase[s*8+4]; cfg[5] = ubase[s*8+5]; cfg[6] = ubase[s*8+6]; cfg[7] = ubase[s*8+7];
      clear_slot_dsp(s);
      s += 1;
    );
    in_gain_norm = ubase[121];
    out_gain_norm = ubase[122];
  ) : (
    in_gain_norm = 0.5;
    out_gain_norm = 0.5;
  );
  sel_slot = 0;
);

function save_user_preset(u_idx) local(u, ubase, s, cfg) (
  u=clamp(u_idx,0,9); ubase=USER_PRESET_BASE+u*128; s=0;
  loop(12,
    cfg=SLOT_CFG_BASE+s*SLOT_CFG_STRIDE;
    ubase[s*8]=cfg[0]; ubase[s*8+1]=cfg[1]; ubase[s*8+2]=cfg[2]; ubase[s*8+3]=cfg[3];
    ubase[s*8+4]=cfg[4]; ubase[s*8+5]=cfg[5]; ubase[s*8+6]=cfg[6]; ubase[s*8+7]=cfg[7]; s+=1;
  );
  ubase[120]=1; ubase[121]=in_gain_norm; ubase[122]=out_gain_norm; cur_preset=u;
);

mem_magic != MEM_MAGIC_VAL ? (
  mem_magic=MEM_MAGIC_VAL;
  memset(USER_PRESET_BASE, 0, 1280);
  in_gain_norm=0.5; out_gain_norm=0.5; sel_slot=0;
  load_preset(0);
) : (
  // When loading a serialized preset, DSP state (delay lines, LFO phases, etc.)
  // is not restored from file. Zero it for every slot so modulation/delay/reverb
  // do not start from garbage state.
  s=0; loop(12, clear_slot_dsp(s); s+=1;);
);

ui_modal_open=0; ui_preset_menu=0; ui_rename_open=0; rename_slot_idx=0; rename_return_menu=0;
#rename_buf=""; #tmp_raw_name="";
ui_save_flash=0; drag_knob=-1; drag_in=0; drag_out=0;
meter_in_L=0; meter_in_R=0; meter_out_L=0; meter_out_R=0;
last_click_t=0; last_click_x=0; last_click_y=0; prev_gfx_w=0; prev_gfx_h=0;

@serialize
file_var(0, mem_magic);
file_var(0, in_gain_norm);
file_var(0, out_gain_norm);
file_var(0, sel_slot);
file_var(0, cur_preset);
file_mem(0, SLOT_CFG_BASE, 192);
file_mem(0, USER_PRESET_BASE, 1280);

@slider
in_gain_norm=slider1; out_gain_norm=slider2;

@block
slider1=in_gain_norm; slider2=out_gain_norm;

blk_s = 0;
loop(12,
  blk_cfg = SLOT_CFG_BASE + blk_s * SLOT_CFG_STRIDE;
  blk_fx = blk_cfg[0];
  blk_dsp = SLOT_DSP_BASE + blk_s * SLOT_DSP_STRIDE;
  blk_p0=blk_cfg[2]; blk_p1=blk_cfg[3]; blk_p2=blk_cfg[4]; blk_p3=blk_cfg[5]; blk_p4=blk_cfg[6]; blk_p5=blk_cfg[7];

  blk_fx==FX_BOOSTER ? ( bq_set_hp(blk_dsp+0,35,0.7); bq_set_hshelf(blk_dsp+10,2400,0.7,(blk_p1-0.4)*10+blk_p2*6); )
  : blk_fx==FX_TS808 ? ( bq_set_hp(blk_dsp+0,120,0.7); bq_set_peak(blk_dsp+10,880,1.0,4.5+blk_p0*4.5); bq_set_lp(blk_dsp+20,950+blk_p1*5200,0.707); )
  : blk_fx==FX_KLON ? ( bq_set_peak(blk_dsp+0,1050,0.85,2.5+blk_p0*3.0); bq_set_hshelf(blk_dsp+10,2200,0.7,(blk_p1-0.5)*10); )
  : blk_fx==FX_BLUESDRV ? ( bq_set_hp(blk_dsp+0,45,0.7); bq_set_lshelf(blk_dsp+10,260,0.7,2.0); bq_set_lp(blk_dsp+20,1200+blk_p1*5800,0.75); )
  : blk_fx==FX_SUPEROD ? ( bq_set_hp(blk_dsp+0,160,0.75); bq_set_peak(blk_dsp+10,1150,1.1,3.5+blk_p0*3.0); bq_set_lp(blk_dsp+20,1100+blk_p1*5400,0.7); )
  : blk_fx==FX_DIST ? ( bq_set_hp(blk_dsp+0,110,0.7); bq_set_peak(blk_dsp+10,1400,0.9,3.0); bq_set_lp(blk_dsp+20,850+blk_p1*6200,0.85); )
  : blk_fx==FX_RAT ? ( bq_set_hp(blk_dsp+0,95,0.75); bq_set_peak(blk_dsp+10,1300,1.0,4.0); bq_set_lp(blk_dsp+20,800+(1-blk_p1)*6500,0.75); )
  : blk_fx==FX_FUZZ ? ( bq_set_lshelf(blk_dsp+0,220,0.7,3.5); bq_set_lp(blk_dsp+10,900+blk_p2*4500,0.7); )
  : blk_fx==FX_MUFF ? ( bq_set_lshelf(blk_dsp+0,240,0.7,(1-blk_p1)*7-2); bq_set_hshelf(blk_dsp+10,2400,0.7,blk_p1*8-3); bq_set_peak(blk_dsp+20,950,1.1,(blk_p2-0.5)*14-4); )
  : blk_fx==FX_73DRIVE ? (
    // Fixed filter coefficients for 73DRIVE (Neve 1073-style preamp)
    bq_set_hp(blk_dsp+0,22,0.7);        // Transformer HP
    bq_set_lp(blk_dsp+10,110,0.7);      // Transformer body LP
    bq_set_lp(blk_dsp+20,13500,0.707);  // Transformer HF LP
    bq_set_hp(blk_dsp+30,18,0.7);       // DC blocker
    bq_set_lp(blk_dsp+40,850,0.707);    // Tone split (low)
    bq_set_hp(blk_dsp+50,850,0.707);    // Tone split (high)
    bq_set_lp(blk_dsp+60,5200,0.707);   // Bright LP
    bq_set_lp(blk_dsp+70,18000,0.707);  // Output LP
  )
  : blk_fx==FX_OCTAVER ? ( bq_set_lp(blk_dsp+0,280,0.9); bq_set_lp(blk_dsp+10,1200+blk_p3*4500,0.75); )
  : (blk_fx>=FX_AMP_FENDER && blk_fx<=FX_AMP_JC120) ? (
    blk_b_db=(blk_p1-0.5)*14; blk_m_db=(blk_p2-0.5)*14; blk_t_db=(blk_p3-0.5)*14; blk_pr_db=(blk_p4-0.5)*10;
    blk_fx==FX_AMP_FENDER ? ( bq_set_hp(blk_dsp+0,65,0.7); bq_set_lshelf(blk_dsp+10,160,0.7,blk_b_db+1.5); bq_set_peak(blk_dsp+20,460,0.9,blk_m_db-4.0); bq_set_hshelf(blk_dsp+30,2400,0.7,blk_t_db+2.5+blk_pr_db*0.5); )
    : blk_fx==FX_AMP_BASSMAN ? ( bq_set_hp(blk_dsp+0,55,0.7); bq_set_lshelf(blk_dsp+10,175,0.7,blk_b_db+2.5); bq_set_peak(blk_dsp+20,650,0.85,blk_m_db+1.5); bq_set_hshelf(blk_dsp+30,2200,0.7,blk_t_db+2.0+blk_pr_db*0.5); )
    : blk_fx==FX_AMP_TWEED ? ( bq_set_hp(blk_dsp+0,80,0.7); bq_set_lshelf(blk_dsp+10,210,0.7,blk_b_db+2.0); bq_set_peak(blk_dsp+20,750,0.85,blk_m_db+3.0); bq_set_hshelf(blk_dsp+30,2100,0.7,blk_t_db+0.5+blk_pr_db*0.4); )
    : blk_fx==FX_AMP_VOX ? ( bq_set_hp(blk_dsp+0,85,0.7); bq_set_lshelf(blk_dsp+10,190,0.7,blk_b_db); bq_set_peak(blk_dsp+20,1300,0.85,blk_m_db+2.5); bq_set_hshelf(blk_dsp+30,2900,0.7,blk_t_db+3.0+blk_pr_db*0.6); )
    : blk_fx==FX_AMP_PLEXI ? ( bq_set_hp(blk_dsp+0,95,0.75); bq_set_lshelf(blk_dsp+10,185,0.7,blk_b_db+1.0); bq_set_peak(blk_dsp+20,900,0.85,blk_m_db+3.0); bq_set_hshelf(blk_dsp+30,2500,0.7,blk_t_db+2.0+blk_pr_db*0.65); )
    : blk_fx==FX_AMP_JCM800 ? ( bq_set_hp(blk_dsp+0,120,0.75); bq_set_lshelf(blk_dsp+10,180,0.7,blk_b_db); bq_set_peak(blk_dsp+20,950,0.95,blk_m_db+3.5); bq_set_hshelf(blk_dsp+30,2600,0.7,blk_t_db+1.5+blk_pr_db*0.7); )
    : blk_fx==FX_AMP_ORANGE ? ( bq_set_hp(blk_dsp+0,75,0.7); bq_set_lshelf(blk_dsp+10,210,0.7,blk_b_db+2.5); bq_set_peak(blk_dsp+20,620,0.85,blk_m_db+4.0); bq_set_hshelf(blk_dsp+30,2300,0.7,blk_t_db-1.0+blk_pr_db*0.6); )
    : blk_fx==FX_AMP_MESA ? ( bq_set_hp(blk_dsp+0,105,0.8); bq_set_lshelf(blk_dsp+10,135,0.7,blk_b_db+2.0); bq_set_peak(blk_dsp+20,720,1.0,blk_m_db-3.5); bq_set_hshelf(blk_dsp+30,3100,0.7,blk_t_db+2.0+blk_pr_db*0.7); )
    : blk_fx==FX_AMP_5150 ? ( bq_set_hp(blk_dsp+0,130,0.8); bq_set_lshelf(blk_dsp+10,145,0.7,blk_b_db+1.5); bq_set_peak(blk_dsp+20,1100,0.95,blk_m_db+1.5); bq_set_hshelf(blk_dsp+30,2900,0.7,blk_t_db+2.5+blk_pr_db*0.7); )
    : ( bq_set_hp(blk_dsp+0,45,0.7); bq_set_lshelf(blk_dsp+10,150,0.7,blk_b_db); bq_set_peak(blk_dsp+20,850,0.8,blk_m_db); bq_set_hshelf(blk_dsp+30,3400,0.7,blk_t_db+2.0+blk_pr_db*0.5); );
  ) : (blk_fx>=FX_CAB_112BF && blk_fx<=FX_CAB_412V30) ? (
    blk_res_db=(blk_p1-0.3)*8; blk_air_db=(blk_p2-0.5)*6;
    blk_fx==FX_CAB_112BF ? ( bq_set_hp(blk_dsp+0,82,0.8); bq_set_peak(blk_dsp+10,115,1.4,blk_res_db); bq_set_peak(blk_dsp+20,2100,1.1,(blk_p0-0.5)*5-2.0); bq_set_lp(blk_dsp+30,4200+blk_p0*1800,0.9); bq_set_hshelf(blk_dsp+40,3200,0.7,blk_air_db); )
    : blk_fx==FX_CAB_212AC ? ( bq_set_hp(blk_dsp+0,90,0.8); bq_set_peak(blk_dsp+10,130,1.3,blk_res_db); bq_set_peak(blk_dsp+20,2600,1.0,(blk_p0-0.5)*5+1.5); bq_set_lp(blk_dsp+30,4500+blk_p0*2000,0.85); bq_set_hshelf(blk_dsp+40,3500,0.7,blk_air_db); )
    : blk_fx==FX_CAB_410TW ? ( bq_set_hp(blk_dsp+0,88,0.8); bq_set_peak(blk_dsp+10,140,1.3,blk_res_db); bq_set_peak(blk_dsp+20,1800,0.9,(blk_p0-0.5)*4); bq_set_lp(blk_dsp+30,3900+blk_p0*1700,0.85); bq_set_hshelf(blk_dsp+40,3000,0.7,blk_air_db); )
    : blk_fx==FX_CAB_412GB ? ( bq_set_hp(blk_dsp+0,75,0.85); bq_set_peak(blk_dsp+10,105,1.5,blk_res_db+1.5); bq_set_peak(blk_dsp+20,1450,1.0,(blk_p0-0.5)*4+1.0); bq_set_lp(blk_dsp+30,3600+blk_p0*1600,0.95); bq_set_hshelf(blk_dsp+40,2800,0.7,blk_air_db); )
    : ( bq_set_hp(blk_dsp+0,72,0.9); bq_set_peak(blk_dsp+10,98,1.5,blk_res_db+2.0); bq_set_peak(blk_dsp+20,2350,1.2,(blk_p0-0.5)*5+2.5); bq_set_lp(blk_dsp+30,4100+blk_p0*1900,0.95); bq_set_hshelf(blk_dsp+40,3100,0.7,blk_air_db); );
  ) : blk_fx==FX_EQ5 ? (
    bq_set_lshelf(blk_dsp+0,100,0.7,(blk_p0-0.5)*24); bq_set_peak(blk_dsp+10,350,1.0,(blk_p1-0.5)*24);
    bq_set_peak(blk_dsp+20,900,1.0,(blk_p2-0.5)*24); bq_set_peak(blk_dsp+30,2500,1.0,(blk_p3-0.5)*24); bq_set_hshelf(blk_dsp+40,6000,0.7,(blk_p4-0.5)*24);
  ) : blk_fx==FX_PARAEQ ? (
    blk_lcf=20*exp(blk_p0*log(400/20)); blk_hcf=1500*exp(blk_p1*log(18000/1500)); blk_mf=220*exp(blk_p3*log(4800/220));
    bq_set_hp(blk_dsp+0,blk_lcf,0.707); bq_set_hp(blk_dsp+10,blk_lcf,0.707);
    bq_set_lp(blk_dsp+20,blk_hcf,0.707); bq_set_lp(blk_dsp+30,blk_hcf,0.707);
    bq_set_lshelf(blk_dsp+40,160,0.7,(blk_p2-0.5)*24); bq_set_peak(blk_dsp+50,blk_mf,1.1,(blk_p4-0.5)*24);
  ) : blk_fx==FX_CHORUS ? ( bq_set_lp(blk_dsp+0,1500+blk_p2*9500,0.7); )
  : blk_fx==FX_ROTARY ? ( bq_set_lp(blk_dsp+0,900,0.7); bq_set_hp(blk_dsp+10,900,0.7); )
  : blk_fx==FX_DELAY ? ( bq_set_lp(blk_dsp+0,900+blk_p2*10000,0.7); )
  : blk_fx==FX_ANALOG_DLY ? ( bq_set_lp(blk_dsp+0,800+blk_p2*3200,0.75); bq_set_hp(blk_dsp+10,110,0.7); )
  : blk_fx==FX_TAPE_ECHO ? ( bq_set_lp(blk_dsp+0,1100+(1-blk_p3)*4200,0.75); bq_set_hp(blk_dsp+10,130,0.7); )
  : blk_fx==FX_SPACE_ECHO ? ( bq_set_lp(blk_dsp+0,5000,0.75); bq_set_hp(blk_dsp+10,140,0.7); bq_set_hp(blk_dsp+20,220,0.7); )
  : (blk_fx>=FX_REV_HALL && blk_fx<=FX_REV_SHIMMER) ? (
    bq_set_hshelf(blk_dsp+0,3200,0.7,(blk_p3-0.5)*14);
    bq_set_hp(blk_dsp+10,blk_fx==FX_REV_SPRING?220:blk_fx==FX_REV_PLATE?140:85,0.7);
    bq_set_hp(blk_dsp+20,480,0.7);
  );
  blk_s += 1;
);

@sample
inL = spl0; inR = spl1;
sr_hz = max(srate, 44100);
in_g = db2lin((in_gain_norm - 0.5) * 48);
sL = inL * in_g; sR = inR * in_g;

m_inL=abs(sL); m_inR=abs(sR);
m_inL = m_inL * 4.0; m_inR = m_inR * 4.0;
meter_in_L = m_inL>meter_in_L ? m_inL : meter_in_L*0.99997;
meter_in_R = m_inR>meter_in_R ? m_inR : meter_in_R*0.99997;

slider3 < 0.5 ? (
  smp_slot = 0;
  loop(12,
    smp_cfg = SLOT_CFG_BASE + smp_slot * SLOT_CFG_STRIDE;
    smp_fx = smp_cfg[0]; smp_byp = smp_cfg[1];
    (smp_fx > 0 && smp_byp == 0) ? (
      smp_dsp = SLOT_DSP_BASE + smp_slot * SLOT_DSP_STRIDE;
      smp_buf = SLOT_BUF_BASE + smp_slot * SLOT_BUF_STRIDE;
      smp_p0=smp_cfg[2]; smp_p1=smp_cfg[3]; smp_p2=smp_cfg[4]; smp_p3=smp_cfg[5]; smp_p4=smp_cfg[6]; smp_p5=smp_cfg[7];

      smp_fx == FX_COMP ? (
        det=max(abs(sL),abs(sR))+0.000000000001;
        att=exp(-1/(sr_hz*(0.001+smp_p2*0.06))); rel=exp(-1/(sr_hz*(0.03+smp_p3*0.45)));
        env=smp_dsp[60]; env=det>env ? (att*env+(1-att)*det) : (rel*env+(1-rel)*det); smp_dsp[60]=env;
        th=db2lin(-38+(1-smp_p0)*34); rat=1.5+smp_p1*10.5;
        gr=env>th ? exp((1/rat-1)*log(env/th)) : 1.0; mk=db2lin(smp_p4*18);
        sL=sL*(1-smp_p5)+sL*gr*mk*smp_p5; sR=sR*(1-smp_p5)+sR*gr*mk*smp_p5;
      )
      : smp_fx == FX_GATE ? (
        det=max(abs(sL),abs(sR)); th=db2lin(-72+smp_p0*52);
        att=exp(-1/(sr_hz*(0.0005+smp_p1*0.02))); rel=exp(-1/(sr_hz*(0.02+smp_p2*0.40)));
        target=det>=th ? 1.0 : (1.0-smp_p3);
        g_cur=smp_dsp[60]; g_cur=target>g_cur ? (att*g_cur+(1-att)*target) : (rel*g_cur+(1-rel)*target);
        smp_dsp[60]=g_cur; sL*=g_cur; sR*=g_cur;
      )
      : smp_fx == FX_AUTOWAH ? (
        det=max(abs(sL),abs(sR)); env=smp_dsp[60]; env=det>env ? (0.985*env+0.015*det) : (0.9994*env+0.0006*det); smp_dsp[60]=env;
        sweep=clamp(env*(2.5+smp_p0*24),0,1); wf=240+sweep*(1200+smp_p2*2600);
        bq_set_bp(smp_dsp+0,wf,1.5+smp_p1*5.5);
        wL=bq_proc_L(smp_dsp+0,sL)*2.2; wR=bq_proc_R(smp_dsp+0,sR)*2.2;
        sL=sL*(1-smp_p3)+wL*smp_p3; sR=sR*(1-smp_p3)+wR*smp_p3;
      )
      : smp_fx == FX_CRYWAH ? (
        wf=350*exp(smp_p0*log(2200/350)); bq_set_bp(smp_dsp+0,wf,2.0+smp_p1*6.0);
        wL=bq_proc_L(smp_dsp+0,sL)*(1.8+smp_p2); wR=bq_proc_R(smp_dsp+0,sR)*(1.8+smp_p2);
        sL=sL*(1-smp_p3)+wL*smp_p3; sR=sR*(1-smp_p3)+wR*smp_p3;
      )
      : smp_fx == FX_TUNER ? (
        t_in = abs(sL)>=abs(sR) ? sL : sR;
        t_pos = smp_dsp[60]; smp_buf[t_pos]=t_in; t_pos=(t_pos+1)%2048; smp_dsp[60]=t_pos;
        t_cnt = smp_dsp[64]+1;
        t_cnt >= 1024 ? (
          t_cnt=0; r0=0; ti=0;
          loop(512, idxA=(t_pos-1-ti+2048)%2048; vA=smp_buf[idxA]; r0+=vA*vA; ti+=1;);
          r0 > 0.0004 ? (
            lag_min=max(20,floor(sr_hz/880)); lag_max=min(980,floor(sr_hz/55)); max_r=0; best_lag=0; tlag=lag_min;
            loop(floor((lag_max-lag_min)/2),
              sum_r=0; ti=0;
              loop(256, idxA=(t_pos-1-ti*2+2048)%2048; idxB=(idxA-tlag+2048)%2048; sum_r+=smp_buf[idxA]*smp_buf[idxB]; ti+=1;);
              sum_r>max_r ? ( max_r=sum_r; best_lag=tlag; ); tlag+=2;
            );
            best_lag > lag_min*2 ? (
              half_lag=floor(best_lag*0.5+0.5); sum_h=0; ti=0;
              loop(256, idxA=(t_pos-1-ti*2+2048)%2048; idxB=(idxA-half_lag+2048)%2048; sum_h+=smp_buf[idxA]*smp_buf[idxB]; ti+=1;);
              sum_h > max_r*0.85 ? ( best_lag=half_lag; max_r=sum_h; );
            );
            best_lag > lag_min+2 ? (
              f_max=-1; f_lag=best_lag; f_idx=3; tlag=best_lag-3;
              loop(7,
                sum_r=0; ti=0;
                loop(256, idxA=(t_pos-1-ti*2+2048)%2048; idxB=(idxA-tlag+2048)%2048; sum_r+=smp_buf[idxA]*smp_buf[idxB]; ti+=1;);
                smp_buf[3000+(tlag-(best_lag-3))]=sum_r;
                sum_r>f_max ? ( f_max=sum_r; f_lag=tlag; f_idx=tlag-(best_lag-3); ); tlag+=1;
              );
              (f_idx>=1 && f_idx<=5) ? (
                r_prev=smp_buf[3000+f_idx-1]; r_cur=smp_buf[3000+f_idx]; r_next=smp_buf[3000+f_idx+1];
                denom=2*(2*r_cur-r_prev-r_next);
                true_lag = denom>0.000001 ? (f_lag+(r_next-r_prev)/denom) : f_lag;
              ) : ( true_lag=f_lag; );
              det_f = sr_hz/max(true_lag,10);
              (det_f>=55 && det_f<=880) ? (
                midi_f=69+12*log(det_f/440)/0.69314718056; note_i=floor(midi_f+0.5); cents=(midi_f-note_i)*100;
                smp_dsp[61]=smp_dsp[61]==0 ? det_f : (smp_dsp[61]*0.55+det_f*0.45);
                smp_dsp[62]=note_i; smp_dsp[63]=smp_dsp[63]*0.55+cents*0.45; smp_dsp[65]=1;
              );
            );
          ) : ( smp_dsp[65]=0; );
        );
        smp_dsp[64]=t_cnt; smp_p0>=0.5 ? ( sL=0; sR=0; );
      )
      : smp_fx == FX_BOOSTER ? (
        dL=bq_proc_L(smp_dsp+0,sL); dR=bq_proc_R(smp_dsp+0,sR);
        dL=bq_proc_L(smp_dsp+10,dL); dR=bq_proc_R(smp_dsp+10,dR);
        g_bst=db2lin(smp_p0*20); sL=soft_tanh(dL*g_bst*0.75)*1.33; sR=soft_tanh(dR*g_bst*0.75)*1.33;
      )
      : smp_fx == FX_TS808 ? (
        dL=bq_proc_L(smp_dsp+0,sL); dR=bq_proc_R(smp_dsp+0,sR); dL=bq_proc_L(smp_dsp+10,dL); dR=bq_proc_R(smp_dsp+10,dR);
        drv=1.5+smp_p0*22.0; dL=soft_tanh(dL*drv); dR=soft_tanh(dR*drv);
        dL=bq_proc_L(smp_dsp+20,dL); dR=bq_proc_R(smp_dsp+20,dR); lvl=0.25+smp_p2*1.6;
        sL=(sL*0.15+dL*0.85)*lvl; sR=(sR*0.15+dR*0.85)*lvl;
      )
      : smp_fx == FX_KLON ? (
        cL=sL*(1.0-smp_p0*0.55); cR=sR*(1.0-smp_p0*0.55); dL=bq_proc_L(smp_dsp+0,sL); dR=bq_proc_R(smp_dsp+0,sR);
        drv=1.2+smp_p0*18.0; dL=soft_tanh(dL*drv+0.08)-soft_tanh(0.08); dR=soft_tanh(dR*drv+0.08)-soft_tanh(0.08);
        oL=bq_proc_L(smp_dsp+10,cL+dL*(0.4+smp_p0*0.9)); oR=bq_proc_R(smp_dsp+10,cR+dR*(0.4+smp_p0*0.9));
        lvl=0.35+smp_p2*1.65; sL=oL*lvl; sR=oR*lvl;
      )
      : smp_fx == FX_BLUESDRV ? (
        dL=bq_proc_L(smp_dsp+0,sL); dR=bq_proc_R(smp_dsp+0,sR); dL=bq_proc_L(smp_dsp+10,dL); dR=bq_proc_R(smp_dsp+10,dR);
        drv1=1.4+smp_p0*12.0; dL=soft_tanh(dL*drv1); dR=soft_tanh(dR*drv1);
        dL=soft_tanh(dL*(1.2+smp_p0*4.5)); dR=soft_tanh(dR*(1.2+smp_p0*4.5));
        dL=bq_proc_L(smp_dsp+20,dL); dR=bq_proc_R(smp_dsp+20,dR); lvl=0.25+smp_p2*1.55; sL=dL*lvl; sR=dR*lvl;
      )
      : smp_fx == FX_SUPEROD ? (
        dL=bq_proc_L(smp_dsp+0,sL); dR=bq_proc_R(smp_dsp+0,sR); dL=bq_proc_L(smp_dsp+10,dL); dR=bq_proc_R(smp_dsp+10,dR);
        drv=1.8+smp_p0*24.0; xL=dL*drv; xR=dR*drv;
        dL=(xL>=0 ? soft_tanh(xL*1.2) : soft_tanh(xL*0.85)); dR=(xR>=0 ? soft_tanh(xR*1.2) : soft_tanh(xR*0.85));
        dL=bq_proc_L(smp_dsp+20,dL); dR=bq_proc_R(smp_dsp+20,dR); lvl=0.25+smp_p2*1.55; sL=dL*lvl; sR=dR*lvl;
      )
      : smp_fx == FX_DIST ? (
        dL=bq_proc_L(smp_dsp+0,sL); dR=bq_proc_R(smp_dsp+0,sR); dL=bq_proc_L(smp_dsp+10,dL); dR=bq_proc_R(smp_dsp+10,dR);
        drv=3.0+smp_p0*42.0; dL=clamp(soft_tanh(dL*drv)*1.15,-0.82,0.82); dR=clamp(soft_tanh(dR*drv)*1.15,-0.82,0.82);
        dL=bq_proc_L(smp_dsp+20,dL); dR=bq_proc_R(smp_dsp+20,dR); lvl=0.22+smp_p2*1.45; sL=dL*lvl; sR=dR*lvl;
      )
      : smp_fx == FX_RAT ? (
        dL=bq_proc_L(smp_dsp+0,sL); dR=bq_proc_R(smp_dsp+0,sR); dL=bq_proc_L(smp_dsp+10,dL); dR=bq_proc_R(smp_dsp+10,dR);
        drv=2.5+smp_p0*48.0;
        dL=clamp(soft_tanh(dL*drv+0.04)-soft_tanh(0.04),-0.78,0.78); dR=clamp(soft_tanh(dR*drv+0.04)-soft_tanh(0.04),-0.78,0.78);
        dL=bq_proc_L(smp_dsp+20,dL); dR=bq_proc_R(smp_dsp+20,dR); lvl=0.24+smp_p2*1.50; sL=dL*lvl; sR=dR*lvl;
      )
      : smp_fx == FX_FUZZ ? (
        dL=bq_proc_L(smp_dsp+0,sL); dR=bq_proc_R(smp_dsp+0,sR); bias=(smp_p1-0.5)*0.55; drv=4.0+smp_p0*50.0;
        dL=soft_tanh(dL*drv+bias)-soft_tanh(bias); dR=soft_tanh(dR*drv+bias)-soft_tanh(bias);
        dL=soft_tanh(dL*2.2); dR=soft_tanh(dR*2.2); dL=bq_proc_L(smp_dsp+10,dL); dR=bq_proc_R(smp_dsp+10,dR);
        lvl=0.20+smp_p3*1.40; sL=dL*lvl; sR=dR*lvl;
      )
      : smp_fx == FX_MUFF ? (
        drv=4.0+smp_p0*55.0; dL=soft_tanh(sL*drv); dR=soft_tanh(sR*drv); dL=soft_tanh(dL*3.5); dR=soft_tanh(dR*3.5);
        dL=bq_proc_L(smp_dsp+0,dL); dR=bq_proc_R(smp_dsp+0,dR); dL=bq_proc_L(smp_dsp+10,dL); dR=bq_proc_R(smp_dsp+10,dR);
        dL=bq_proc_L(smp_dsp+20,dL); dR=bq_proc_R(smp_dsp+20,dR); lvl=0.22+smp_p3*1.45; sL=dL*lvl; sR=dR*lvl;
      )
      : smp_fx == FX_73DRIVE ? (
        // Neve 1073-style preamp with transformer emulation
        // Parameters: p0=DRIVE, p1=TONE, p2=OUTPUT, p3=TRANSFORMER, p4=SOFT_CLIP, p5=INPUT_GAIN
        // Biquads: 0=TR_HP(22), 10=TR_BODY_LP(110), 20=TR_HF_LP(13500), 30=DC_HP(18)
        //          40=TONE_LP(850), 50=TONE_HP(850), 60=BRIGHT_LP(5200), 70=OUT_LP(18000)
        
        // Input gain
        in_g73 = db2lin(smp_p5 * 36 - 18);  // -18 to +18 dB
        xL = sL * in_g73; xR = sR * in_g73;
        
        // Transformer emulation chain
        // HP at 22Hz
        xL = bq_proc_L(smp_dsp+0, xL); xR = bq_proc_R(smp_dsp+0, xR);
        // Body resonance at 110Hz
        tr_bodyL = bq_proc_L(smp_dsp+10, xL); tr_bodyR = bq_proc_R(smp_dsp+10, xR);
        tr_sigL = xL + tr_bodyL * 0.16; tr_sigR = xR + tr_bodyR * 0.16;
        // HF rolloff at 13500Hz
        tr_sigL = bq_proc_L(smp_dsp+20, tr_sigL); tr_sigR = bq_proc_R(smp_dsp+20, tr_sigR);
        
        // Transformer saturation drive
        tr_drv = 1.0 + smp_p3 * 0.90;
        tr_xL = tr_sigL * tr_drv; tr_xR = tr_sigR * tr_drv;
        tr_xL >= 0 ? ( tr_colL = tr_xL / (1.0 + tr_xL * 0.85); ) : ( tr_colL = tr_xL / (1.0 - tr_xL * 1.20); );
        tr_xR >= 0 ? ( tr_colR = tr_xR / (1.0 + tr_xR * 0.85); ) : ( tr_colR = tr_xR / (1.0 - tr_xR * 1.20); );
        tr_colL = tr_colL / tr_drv; tr_colR = tr_colR / tr_drv;
        // Even harmonic enhancement
        tr_colL += 0.025 * smp_p3 * (tr_colL * tr_colL - 0.08);
        tr_colR += 0.025 * smp_p3 * (tr_colR * tr_colR - 0.08);
        // Mix transformed with dry
        xL = xL * (1.0 - smp_p3) + tr_colL * smp_p3;
        xR = xR * (1.0 - smp_p3) + tr_colR * smp_p3;
        
        // Preamp gain stage
        pre_gain = db2lin((smp_p0 ^ 1.35) * 42.0);  // DRIVE^1.35 * 42dB
        pre_xL = xL * pre_gain; pre_xR = xR * pre_gain;
        // Asymmetric saturation (Neve-style)
        pre_xL >= 0 ? ( pre_yL = pre_xL / (1.0 + pre_xL * 0.85); ) : ( pre_yL = pre_xL / (1.0 - pre_xL * 1.05); );
