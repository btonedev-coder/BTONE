          sqrt(sqr(mx-ui_kcx)+sqr(my-ui_kcy))<=ui_kr+12?(ui_cfg_sel[2+ui_k]=clamp(ui_cfg_sel[2+ui_k]+step_w,0,1););
          ui_k+=1;
        );
