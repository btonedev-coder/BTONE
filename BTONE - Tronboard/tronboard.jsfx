        ui_s=0; loop(12,
          ui_row=ui_s<6?0:1; ui_col=ui_s%6; ui_sx=start_x+ui_col*(slot_w+gap_x); ui_sy=ui_row==0?row1_y:row2_y;
          hit_rect(ui_sx,ui_sy,slot_w,slot_h) ? (
            sel_slot=ui_s; ui_cfg_c=SLOT_CFG_BASE+ui_s*SLOT_CFG_STRIDE;
