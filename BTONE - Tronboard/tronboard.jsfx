        tap3L=smp_buf[rA]*(1-f3)+smp_buf[rB]*f3; tap3R=smp_buf[blen+rA]*(1-f3)+smp_buf[blen+rB]*f3;
        w_h2=clamp(smp_p2*2.0,0,1); w_h1=clamp((smp_p2-0.45)*2.0,0,1);
        eL=tap3L+tap2L*w_h2*0.80+tap1L*w_h1*0.65; eR=tap3R+tap1R*w_h1*0.80+tap2R*w_h2*0.65;
        eL=bq_proc_L(smp_dsp+0,eL); eR=bq_proc_R(smp_dsp+0,eR); eL=bq_proc_L(smp_dsp+10,eL); eR=bq_proc_R(smp_dsp+10,eR);
        fb=smp_p1*0.88; smp_buf[wpos]=soft_tanh(sL+tap3L*fb+tap2L*w_h2*fb*0.25); smp_buf[blen+wpos]=soft_tanh(sR+tap3R*fb+tap2R*w_h2*fb*0.25);
        smp_dsp[60]=(wpos+1)%blen;
        sp_in=bq_proc_L(smp_dsp+20,(sL+sR)*0.5+(eL+eR)*0.3); sp_acc=0; smp_c=0;
        loop(4,
          c_lenL=smp_c==0?743:smp_c==1?881:smp_c==2?1019:1153; posL=smp_dsp[90+smp_c]; bL=132000+smp_c*1500;
          oL=smp_buf[bL+posL]; fL=smp_dsp[94+smp_c]; fL=oL*0.65+fL*0.35; smp_dsp[94+smp_c]=fL;
          smp_buf[bL+posL]=soft_tanh(sp_in+fL*0.84); smp_dsp[90+smp_c]=(posL+1)%c_lenL; sp_acc+=oL; smp_c+=1;
        );
        sp_out=sp_acc*0.55; dry_g=1.0-max(0,(smp_p5-0.5)*1.5); wet_g=smp_p5*1.15;
        sL=sL*dry_g+(eL*0.85+sp_out*smp_p4*0.85)*wet_g; sR=sR*dry_g+(eR*0.85+sp_out*smp_p4*0.85)*wet_g;
      )
      : (smp_fx>=FX_REV_HALL && smp_fx<=FX_REV_SHIMMER) ? (
        pd_w=smp_dsp[60]; pd_len=clamp(floor((0.002+smp_p1*0.12)*sr_hz),1,16000);
        mono_in=(abs(sR)<0.000001 && abs(sL)>0.0001)?sL:((sL+sR)*0.5);
        mono_in=bq_proc_L(smp_dsp+10,mono_in); smp_buf[pd_w]=mono_in;
        pd_r=(pd_w-pd_len+16384)%16384; in_rev=smp_buf[pd_r]; smp_dsp[60]=(pd_w+1)%16384;
        smp_fx==FX_REV_SHIMMER ? ( shim_raw=bq_proc_L(smp_dsp+20,abs(smp_dsp[61])*1.6); in_rev+=soft_tanh(shim_raw)*smp_p4*0.55; )
        : smp_fx==FX_REV_SPRING ? ( in_rev=soft_tanh(in_rev*(1.1+smp_p4*1.3))*0.85; );
        room=0.74+smp_p0*0.242; damp=0.08+smp_p2*0.72; sr_scale=sr_hz/44100; accL=0; accR=0; smp_c=0;
        loop(8,
          c_base=smp_c==0?1116:smp_c==1?1188:smp_c==2?1277:smp_c==3?1356:smp_c==4?1422:smp_c==5?1491:smp_c==6?1557:1617;
          smp_fx==FX_REV_PLATE ? (c_base=floor(c_base*0.82);); smp_fx==FX_REV_SPRING ? (c_base=floor(c_base*0.68););
          c_lenL=clamp(floor(c_base*sr_scale),80,3900); c_lenR=clamp(c_lenL+23,80,3900);
          posL=smp_dsp[100+smp_c]; posR=smp_dsp[110+smp_c]; bL=20000+smp_c*4000; bR=52000+smp_c*4000;
          oL=smp_buf[bL+posL]; oR=smp_buf[bR+posR]; fL=smp_dsp[120+smp_c]; fR=smp_dsp[130+smp_c];
          fL=oL*(1-damp)+fL*damp; fR=oR*(1-damp)+fR*damp; smp_dsp[120+smp_c]=fL; smp_dsp[130+smp_c]=fR;
          smp_buf[bL+posL]=soft_tanh((in_rev+fL*room)*0.5)*2.0; smp_buf[bR+posR]=soft_tanh((in_rev+fR*room)*0.5)*2.0;
          smp_dsp[100+smp_c]=(posL+1)%c_lenL; smp_dsp[110+smp_c]=(posR+1)%c_lenR; accL+=oL; accR+=oR; smp_c+=1;
        );
        accL*=0.15; accR*=0.15; smp_a=0;
        // Unity-gain Schroeder allpasses (0dB flat at all frequencies!)
        loop(4,
          a_base=smp_a==0?556:smp_a==1?441:smp_a==2?341:225;
          a_lenL=clamp(floor(a_base*sr_scale),40,1900); a_lenR=clamp(a_lenL+23,40,1900);
          ap_pL=smp_dsp[140+smp_a]; ap_pR=smp_dsp[145+smp_a]; abL=84000+smp_a*2000; abR=92000+smp_a*2000;
          boL=smp_buf[abL+ap_pL]; boR=smp_buf[abR+ap_pR];
          vL=accL-0.5*boL; smp_buf[abL+ap_pL]=vL; accL=boL+0.5*vL;
          vR=accR-0.5*boR; smp_buf[abR+ap_pR]=vR; accR=boR+0.5*vR;
          smp_dsp[140+smp_a]=(ap_pL+1)%a_lenL; smp_dsp[145+smp_a]=(ap_pR+1)%a_lenR; smp_a+=1;
        );
        smp_dsp[61]=clamp((accL+accR)*0.5,-1.5,1.5);
        accL=bq_proc_L(smp_dsp+0,accL); accR=bq_proc_R(smp_dsp+0,accR);
        wetL=soft_tanh(accL*1.8)*1.15; wetR=soft_tanh(accR*1.8)*1.15;
        dry_g=1.0-max(0,(smp_p5-0.5)*1.5); wet_g=smp_p5*1.25;
        sL=sL*dry_g+wetL*wet_g; sR=sR*dry_g+wetR*wet_g;
      );
      sL=clamp(sL,-4,4); sR=clamp(sR,-4,4);
    );
    smp_slot+=1;
  );
);

out_g = db2lin((out_gain_norm - 0.5) * 48);
sL = soft_tanh(sL * out_g * 0.75) * 1.33;
sR = soft_tanh(sR * out_g * 0.75) * 1.33;

m_outL=abs(sL); m_outR=abs(sR);
m_outL = m_outL * 4.0; m_outR = m_outR * 4.0;
meter_out_L=m_outL>meter_out_L?m_outL:meter_out_L*0.99997;
meter_out_R=m_outR>meter_out_R?m_outR:meter_out_R*0.99997;
spl0=sL; spl1=sR;


@gfx 960 600
function vx(x) ( ox + x * sc; );
function vy(y) ( oy + y * sc; );
function vs(v) ( v * sc; );

function fill_rrect(x, y, w, h, r) local(rx, ry, rw, rh, rr, iy, dy, dx) (
  rx=floor(vx(x)+0.5); ry=floor(vy(y)+0.5); rw=floor(vs(w)+0.5); rh=floor(vs(h)+0.5);
  rr=floor(min(vs(r),min(rw*0.5,rh*0.5))+0.5);
  rr<=0 ? gfx_rect(rx,ry,rw,rh) : (
    gfx_rect(rx,ry+rr,rw,rh-2*rr); gfx_rect(rx+rr,ry,rw-2*rr,rr); gfx_rect(rx+rr,ry+rh-rr,rw-2*rr,rr);
    iy=0; loop(rr,
      dy=rr-iy-0.5; dx=floor(sqrt(max(0,rr*rr-dy*dy))+0.5);
      dx>0 ? ( gfx_rect(rx+rr-dx,ry+iy,dx,1); gfx_rect(rx+rw-rr,ry+iy,dx,1);
        gfx_rect(rx+rr-dx,ry+rh-1-iy,dx,1); gfx_rect(rx+rw-rr,ry+rh-1-iy,dx,1); );
      iy+=1;
    );
  );
);
function stroke_rrect(x, y, w, h, r) ( gfx_roundrect(vx(x),vy(y),vs(w),vs(h),vs(r),1); );

function draw_soft_halo(cx, cy, r_core, spread, rC, gC, bC, intensity) local(step, t, rr, a, d) (
  gfx_mode=1; step=0;
  loop(24, t=step/23; d=t*spread; rr=r_core+d; a=intensity*0.042*exp(-(d*d)/(2*sqr(spread*0.34)));
    gfx_set(rC,gC,bC,a); gfx_circle(vx(cx),vy(cy),vs(rr),1,1); step+=1; );
  gfx_mode=0;
);
function draw_soft_rrect_bloom(x, y, w, h, r, spread, rC, gC, bC, intensity) local(step, t, d, a) (
  gfx_mode=1; step=0;
  loop(18, t=step/17; d=0.5+t*spread; a=intensity*0.022*exp(-(t*t)/0.22);
    gfx_set(rC,gC,bC,a); fill_rrect(x-d,y-d,w+2*d,h+2*d,r+d*0.8); step+=1; );
  gfx_mode=0;
);
function draw_inner_glass_glow(x, y, w, h, r, depth, rC, gC, bC, peak_a) local(px, py, pw, ph, pd) (
  px=vx(x+2); py=vy(y+2); pw=vs(w-4); ph=vs(h-4); pd=max(1,vs(depth)); gfx_mode=1;
  gfx_gradrect(px,py,pw,pd,rC,gC,bC,peak_a,0,0,0,0,0,0,0,-peak_a/pd);
  gfx_gradrect(px,py+ph-pd,pw,pd,rC,gC,bC,0,0,0,0,0,0,0,0,peak_a/pd);
  gfx_gradrect(px,py,pd,ph,rC,gC,bC,peak_a*0.8,0,0,0,-(peak_a*0.8)/pd,0,0,0,0);
  gfx_gradrect(px+pw-pd,py,pd,ph,rC,gC,bC,0,0,0,0,(peak_a*0.8)/pd,0,0,0,0);
  gfx_mode=0;
);
function draw_neon_line_bloom(x1, y1, x2, y2) local(lx, ly, lw, lh, step, t, d, a) (
  lx=min(x1,x2); ly=min(y1,y2); lw=abs(x2-x1); lh=abs(y2-y1); gfx_mode=1; step=0;
  loop(18, t=step/17; d=0.8+t*11.0; a=0.024*exp(-(t*t)/0.22); gfx_set(0.08,0.86,1.0,a); fill_rrect(lx-d,ly-d,lw+2*d,lh+2*d,d); step+=1; );
  gfx_mode=0;
);
function draw_neon_line_core(x1, y1, x2, y2, active) local(lx, ly, lw, lh) (
  lx=min(x1,x2); ly=min(y1,y2); lw=abs(x2-x1); lh=abs(y2-y1);
  active ? (
    gfx_set(0.32,0.93,1.0,0.95); fill_rrect(lx-1.5,ly-1.5,lw+3.0,lh+3.0,1.5);
    gfx_set(0.76,0.99,1.0,0.98); fill_rrect(lx-0.65,ly-0.65,lw+1.3,lh+1.3,0.65);
  ) : ( gfx_set(0.14,0.30,0.38,0.42); fill_rrect(lx-0.6,ly-0.6,lw+1.2,lh+1.2,0.6); );
);
function draw_glow_circle(cx, cy, r, rC, gC, bC, intensity) (
  draw_soft_halo(cx,cy,r*0.4,r*4.2,rC,gC,bC,intensity*1.15);
  gfx_set(rC,gC,bC,0.95*intensity); gfx_circle(vx(cx),vy(cy),vs(r),1,1);
  gfx_set(0.90,1.0,1.0,0.88*intensity); gfx_circle(vx(cx),vy(cy),vs(r*0.45),1,1);
);
function hit_rect(x, y, w, h) ( mx>=x && mx<=x+w && my>=y && my<=y+h; );

// TRON IDENTITY DISC (Replaces "O" in BTONE)
function draw_tron_disc(cx, cy, r_out) local(ccx, ccy, i, ang, r_body, r_in, r_bez, r_hole, x1, y1, x2, y2, gap_a) (
  ccx=vx(cx); ccy=vy(cy);
  r_body=r_out*0.81; r_in=r_out*0.56; r_bez=r_out*0.48; r_hole=r_out*0.355; gap_a=0.38;

  // Outer amber/orange energy halo (matches BT / NE halo)
  draw_soft_halo(cx, cy, r_out*0.78, r_out*0.88, 1.0, 0.45, 0.04, 0.72);

  // Outer glowing gold blade rim (matches BT / NE fill & highlight)
  gfx_set(1.0, 0.82, 0.18, 0.98);
  gfx_circle(ccx, ccy, vs(r_out), 1, 1);
  gfx_set(1.0, 0.95, 0.55, 0.85);
  gfx_circle(ccx, ccy, vs(r_out-0.42), 0, 1);

  // Radial blade micro-grooves on outer gold ring
  gfx_set(0.65, 0.32, 0.03, 0.45);
  i=0; loop(36,
    ang=i*(2*$pi/36);
    x1=cx+sin(ang)*(r_body+0.15); y1=cy-cos(ang)*(r_body+0.15);
    x2=cx+sin(ang)*(r_out-0.25);  y2=cy-cos(ang)*(r_out-0.25);
    gfx_line(vx(x1), vy(y1), vx(x2), vy(y2), 1);
    i+=1;
  );

  // Dark gunmetal disc body
  gfx_set(0.11, 0.11, 0.12, 1.0);
  gfx_circle(ccx, ccy, vs(r_body), 1, 1);
  gfx_set(0.30, 0.27, 0.24, 0.72);
  gfx_arc(ccx, ccy, vs(r_body-0.35), -2.4, -0.5, 1);
  gfx_arc(ccx, ccy, vs(r_body-0.35), 0.7, 2.5, 1);

  // 4 angled metallic struts & outer rim notches
  i=0; loop(4,
    ang = i==0 ? -0.62 : i==1 ? 0.62 : i==2 ? ($pi-0.62) : ($pi+0.62);
    gfx_set(0.11, 0.11, 0.12, 0.95);
    x1=cx+sin(ang)*(r_body-0.3); y1=cy-cos(ang)*(r_body-0.3);
    x2=cx+sin(ang)*(r_body+0.85); y2=cy-cos(ang)*(r_body+0.85);
    gfx_line(vx(x1), vy(y1), vx(x2), vy(y2), 1);
    gfx_set(0.42, 0.38, 0.34, 0.80);
    x1=cx+sin(ang)*(r_in+0.65); y1=cy-cos(ang)*(r_in+0.65);
    x2=cx+sin(ang)*(r_body-0.1); y2=cy-cos(ang)*(r_body-0.1);
    gfx_line(vx(x1), vy(y1), vx(x2), vy(y2), 1);
    i+=1;
  );

  // Inner glowing gold/amber C-ring (broken at 12 o'clock)
  gfx_mode=1;
  gfx_set(1.0, 0.48, 0.04, 0.38);
  gfx_arc(ccx, ccy, vs(r_in-0.75), gap_a, 2*$pi-gap_a, 1);
  gfx_arc(ccx, ccy, vs(r_in+0.75), gap_a, 2*$pi-gap_a, 1);
  gfx_mode=0;

  gfx_set(1.0, 0.82, 0.18, 0.98);
  gfx_arc(ccx, ccy, vs(r_in-0.32), gap_a, 2*$pi-gap_a, 1);
  gfx_arc(ccx, ccy, vs(r_in),      gap_a, 2*$pi-gap_a, 1);
  gfx_arc(ccx, ccy, vs(r_in+0.32), gap_a, 2*$pi-gap_a, 1);
  gfx_set(1.0, 0.95, 0.55, 0.92);
  gfx_arc(ccx, ccy, vs(r_in), gap_a+0.04, 2*$pi-gap_a-0.04, 1);

  // Inner dark bezel + top latch + 4 gold corner nodes
  gfx_set(0.15, 0.14, 0.15, 1.0);
  gfx_circle(ccx, ccy, vs(r_bez), 1, 1);
  gfx_set(0.38, 0.35, 0.32, 0.72);
  gfx_circle(ccx, ccy, vs(r_bez), 0, 1);

  gfx_set(0.34, 0.31, 0.28, 0.75);
  gfx_rect(vx(cx-1.35), vy(cy-r_bez+0.12), vs(2.7), vs(1.15));
  gfx_set(0.07, 0.07, 0.08, 0.95);
  gfx_rect(vx(cx-1.1), vy(cy-r_bez+0.28), vs(2.2), vs(0.82));

  i=0; loop(4,
    ang=$pi*0.25+i*($pi*0.5);
    x1=cx+sin(ang)*((r_bez+r_hole)*0.52); y1=cy-cos(ang)*((r_bez+r_hole)*0.52);
    gfx_set(0.06, 0.06, 0.07, 1.0); gfx_circle(vx(x1), vy(y1), vs(0.75), 1, 1);
    gfx_set(1.0, 0.82, 0.18, 0.92); gfx_circle(vx(x1), vy(y1), vs(0.42), 1, 1);
    i+=1;
  );

  // Hollow center hole matching top bar background
  gfx_set(0.07, 0.10, 0.13, 1.0);
  gfx_circle(ccx, ccy, vs(r_hole), 1, 1);
  gfx_set(0.03, 0.05, 0.07, 0.95);
  gfx_circle(ccx, ccy, vs(r_hole), 0, 1);
);

function get_fx_short_name(fx_id, out_str) (
  fx_id==FX_EMPTY?strcpy(out_str,"EMPTY SLOT") : fx_id==FX_COMP?strcpy(out_str,"COMPRESSOR") : fx_id==FX_GATE?strcpy(out_str,"NOISE GATE")
  : fx_id==FX_AUTOWAH?strcpy(out_str,"AUTO-WAH") : fx_id==FX_CRYWAH?strcpy(out_str,"CRY WAH") : fx_id==FX_TUNER?strcpy(out_str,"CHROM TUNER")
  : fx_id==FX_OCTAVER?strcpy(out_str,"OCTAVER") : fx_id==FX_BOOSTER?strcpy(out_str,"BOOSTER") : fx_id==FX_TS808?strcpy(out_str,"TS808 OD") : fx_id==FX_KLON?strcpy(out_str,"KLON CENTAUR")
  : fx_id==FX_BLUESDRV?strcpy(out_str,"BLUES DRV") : fx_id==FX_SUPEROD?strcpy(out_str,"SUPER OD") : fx_id==FX_DIST?strcpy(out_str,"DISTORTION")
  : fx_id==FX_RAT?strcpy(out_str,"RAT DIST") : fx_id==FX_FUZZ?strcpy(out_str,"FUZZ FACE") : fx_id==FX_MUFF?strcpy(out_str,"BIG MUFF")
  : fx_id==FX_73DRIVE?strcpy(out_str,"73 DRIVE") : fx_id==FX_AMP_FENDER?strcpy(out_str,"DELUXE AMP") : fx_id==FX_AMP_BASSMAN?strcpy(out_str,"BASSMAN AMP")
  : fx_id==FX_AMP_TWEED?strcpy(out_str,"TWEED 5E3") : fx_id==FX_AMP_VOX?strcpy(out_str,"VOX AC30") : fx_id==FX_AMP_PLEXI?strcpy(out_str,"PLEXI AMP")
  : fx_id==FX_AMP_JCM800?strcpy(out_str,"JCM800 AMP") : fx_id==FX_AMP_ORANGE?strcpy(out_str,"ORANGE AMP") : fx_id==FX_AMP_MESA?strcpy(out_str,"MESA BOOGIE")
  : fx_id==FX_AMP_5150?strcpy(out_str,"5150 METAL") : fx_id==FX_AMP_JC120?strcpy(out_str,"JC-120 CLEAN") : fx_id==FX_CAB_112BF?strcpy(out_str,"1x12 BF CAB")
  : fx_id==FX_CAB_212AC?strcpy(out_str,"2x12 AC CAB") : fx_id==FX_CAB_410TW?strcpy(out_str,"4x10 TWEED") : fx_id==FX_CAB_412GB?strcpy(out_str,"4x12 GB CAB")
  : fx_id==FX_CAB_412V30?strcpy(out_str,"4x12 V30 CAB") : fx_id==FX_EQ5?strcpy(out_str,"5-BAND EQ") : fx_id==FX_PARAEQ?strcpy(out_str,"PARAMETRIC EQ")
  : fx_id==FX_CHORUS?strcpy(out_str,"CHORUS") : fx_id==FX_FLANGER?strcpy(out_str,"FLANGER") : fx_id==FX_PHASER?strcpy(out_str,"PHASER")
  : fx_id==FX_TREMOLO?strcpy(out_str,"TREMOLO") : fx_id==FX_ROTARY?strcpy(out_str,"ROTARY / VIB") : fx_id==FX_DELAY?strcpy(out_str,"DIGITAL DLY")
  : fx_id==FX_ANALOG_DLY?strcpy(out_str,"ANALOG DLY") : fx_id==FX_TAPE_ECHO?strcpy(out_str,"TAPE ECHO") : fx_id==FX_SPACE_ECHO?strcpy(out_str,"SPACE ECHO")
  : fx_id==FX_REV_HALL?strcpy(out_str,"HALL REVERB") : fx_id==FX_REV_PLATE?strcpy(out_str,"PLATE REVERB") : fx_id==FX_REV_SPRING?strcpy(out_str,"SPRING REV")
  : strcpy(out_str,"SHIMMER REV");
);

function get_fx_param_count(fx_id) (
  fx_id==FX_EMPTY ? 0 : fx_id==FX_COMP ? 6 : fx_id==FX_GATE ? 4 : fx_id==FX_AUTOWAH ? 4 : fx_id==FX_CRYWAH ? 4 : fx_id==FX_TUNER ? 1
  : fx_id==FX_OCTAVER ? 4 : (fx_id>=FX_BOOSTER && fx_id<=FX_RAT) ? 3 : (fx_id>=FX_FUZZ && fx_id<=FX_MUFF) ? 4
  : fx_id==FX_73DRIVE ? 6 : (fx_id>=FX_AMP_FENDER && fx_id<=FX_AMP_JC120) ? 6 : (fx_id>=FX_CAB_112BF && fx_id<=FX_CAB_412V30) ? 4
  : (fx_id==FX_EQ5 || fx_id==FX_PARAEQ) ? 6 : (fx_id>=FX_CHORUS && fx_id<=FX_TREMOLO) ? 4 : fx_id==FX_ROTARY ? 5 : 6;
);

function get_fx_param_label(fx_id, p_idx, out_str) (
  fx_id==FX_COMP ? ( p_idx==0?strcpy(out_str,"THRESH"):p_idx==1?strcpy(out_str,"RATIO"):p_idx==2?strcpy(out_str,"ATTACK"):p_idx==3?strcpy(out_str,"RELEASE"):p_idx==4?strcpy(out_str,"MAKEUP"):strcpy(out_str,"MIX"); )
  : fx_id==FX_GATE ? ( p_idx==0?strcpy(out_str,"THRESH"):p_idx==1?strcpy(out_str,"ATTACK"):p_idx==2?strcpy(out_str,"DECAY"):strcpy(out_str,"RANGE"); )
  : fx_id==FX_AUTOWAH ? ( p_idx==0?strcpy(out_str,"SENS"):p_idx==1?strcpy(out_str,"RESONANCE"):p_idx==2?strcpy(out_str,"RANGE"):strcpy(out_str,"MIX"); )
  : fx_id==FX_CRYWAH ? ( p_idx==0?strcpy(out_str,"PEDAL"):p_idx==1?strcpy(out_str,"Q PEAK"):p_idx==2?strcpy(out_str,"BOOST"):strcpy(out_str,"MIX"); )
  : fx_id==FX_TUNER ? ( strcpy(out_str,"MUTE"); )
  : fx_id==FX_BOOSTER ? ( p_idx==0?strcpy(out_str,"BOOST"):p_idx==1?strcpy(out_str,"TONE"):strcpy(out_str,"BRIGHT"); )
  : (fx_id==FX_TS808 || fx_id==FX_SUPEROD) ? ( p_idx==0?strcpy(out_str,"DRIVE"):p_idx==1?strcpy(out_str,"TONE"):strcpy(out_str,"LEVEL"); )
  : fx_id==FX_KLON ? ( p_idx==0?strcpy(out_str,"GAIN"):p_idx==1?strcpy(out_str,"TREBLE"):strcpy(out_str,"OUTPUT"); )
  : fx_id==FX_BLUESDRV ? ( p_idx==0?strcpy(out_str,"GAIN"):p_idx==1?strcpy(out_str,"TONE"):strcpy(out_str,"LEVEL"); )
  : (fx_id==FX_DIST || fx_id==FX_RAT) ? ( p_idx==0?strcpy(out_str,"DIST"):p_idx==1?strcpy(out_str,"FILTER"):strcpy(out_str,"VOLUME"); )
  : fx_id==FX_FUZZ ? ( p_idx==0?strcpy(out_str,"FUZZ"):p_idx==1?strcpy(out_str,"BIAS"):p_idx==2?strcpy(out_str,"TONE"):strcpy(out_str,"VOLUME"); )
  : fx_id==FX_MUFF ? ( p_idx==0?strcpy(out_str,"SUSTAIN"):p_idx==1?strcpy(out_str,"TONE"):p_idx==2?strcpy(out_str,"MIDS"):strcpy(out_str,"VOLUME"); )
  : fx_id==FX_73DRIVE ? ( p_idx==0?strcpy(out_str,"DRIVE"):p_idx==1?strcpy(out_str,"TONE"):p_idx==2?strcpy(out_str,"OUTPUT"):p_idx==3?strcpy(out_str,"XFORMER"):p_idx==4?strcpy(out_str,"SOFTCLIP"):strcpy(out_str,"INPUT"); )
  : fx_id==FX_OCTAVER ? ( p_idx==0?strcpy(out_str,"SUB OCT"):p_idx==1?strcpy(out_str,"OCT UP"):p_idx==2?strcpy(out_str,"DRY"):strcpy(out_str,"TONE"); )
  : (fx_id>=FX_AMP_FENDER && fx_id<=FX_AMP_JC120) ? ( p_idx==0?strcpy(out_str,"GAIN"):p_idx==1?strcpy(out_str,"BASS"):p_idx==2?strcpy(out_str,"MID"):p_idx==3?strcpy(out_str,"TREBLE"):p_idx==4?strcpy(out_str,"PRESENCE"):strcpy(out_str,"MASTER"); )
  : (fx_id>=FX_CAB_112BF && fx_id<=FX_CAB_412V30) ? ( p_idx==0?strcpy(out_str,"MIC AXIS"):p_idx==1?strcpy(out_str,"RESONANCE"):p_idx==2?strcpy(out_str,"AIR"):strcpy(out_str,"LEVEL"); )
  : fx_id==FX_EQ5 ? ( p_idx==0?strcpy(out_str,"100 HZ"):p_idx==1?strcpy(out_str,"350 HZ"):p_idx==2?strcpy(out_str,"900 HZ"):p_idx==3?strcpy(out_str,"2.5 KHZ"):p_idx==4?strcpy(out_str,"6.0 KHZ"):strcpy(out_str,"LEVEL"); )
  : fx_id==FX_PARAEQ ? ( p_idx==0?strcpy(out_str,"LOW CUT"):p_idx==1?strcpy(out_str,"HIGH CUT"):p_idx==2?strcpy(out_str,"LOW GAIN"):p_idx==3?strcpy(out_str,"MID FREQ"):p_idx==4?strcpy(out_str,"MID GAIN"):strcpy(out_str,"LEVEL"); )
  : (fx_id==FX_CHORUS || fx_id==FX_FLANGER || fx_id==FX_PHASER) ? ( p_idx==0?strcpy(out_str,"RATE"):p_idx==1?strcpy(out_str,"DEPTH"):p_idx==2?strcpy(out_str,fx_id==FX_CHORUS?"TONE":"FEEDBACK"):strcpy(out_str,"MIX"); )
  : fx_id==FX_TREMOLO ? ( p_idx==0?strcpy(out_str,"RATE"):p_idx==1?strcpy(out_str,"DEPTH"):p_idx==2?strcpy(out_str,"SHAPE"):strcpy(out_str,"STEREO"); )
  : fx_id==FX_ROTARY ? ( p_idx==0?strcpy(out_str,"SPEED"):p_idx==1?strcpy(out_str,"DEPTH"):p_idx==2?strcpy(out_str,"HORN BAL"):p_idx==3?strcpy(out_str,"DRIVE"):strcpy(out_str,"MIX"); )
  : fx_id==FX_DELAY ? ( p_idx==0?strcpy(out_str,"TIME"):p_idx==1?strcpy(out_str,"FEEDBACK"):p_idx==2?strcpy(out_str,"TONE"):p_idx==3?strcpy(out_str,"MOD"):p_idx==4?strcpy(out_str,"SPREAD"):strcpy(out_str,"MIX"); )
  : fx_id==FX_ANALOG_DLY ? ( p_idx==0?strcpy(out_str,"TIME"):p_idx==1?strcpy(out_str,"FEEDBACK"):p_idx==2?strcpy(out_str,"WARMTH"):p_idx==3?strcpy(out_str,"MOD"):p_idx==4?strcpy(out_str,"SPREAD"):strcpy(out_str,"MIX"); )
  : fx_id==FX_TAPE_ECHO ? ( p_idx==0?strcpy(out_str,"TIME"):p_idx==1?strcpy(out_str,"REPEATS"):p_idx==2?strcpy(out_str,"WOW/FLUT"):p_idx==3?strcpy(out_str,"TAPE AGE"):p_idx==4?strcpy(out_str,"SATURATE"):strcpy(out_str,"MIX"); )
  : fx_id==FX_SPACE_ECHO ? ( p_idx==0?strcpy(out_str,"RATE/TIME"):p_idx==1?strcpy(out_str,"INTENSITY"):p_idx==2?strcpy(out_str,"HEADS"):p_idx==3?strcpy(out_str,"FLUTTER"):p_idx==4?strcpy(out_str,"REVERB"):strcpy(out_str,"MIX"); )
  : ( p_idx==0?strcpy(out_str,"DECAY"):p_idx==1?strcpy(out_str,"PRE-DLY"):p_idx==2?strcpy(out_str,"DAMP"):p_idx==3?strcpy(out_str,"TONE"):p_idx==4?strcpy(out_str,fx_id==FX_REV_SHIMMER?"SHIMMER":"CHARACTER"):strcpy(out_str,"MIX"); );
);

function format_param_val(fx_id, p_idx, val, out_str) (
  fx_id==FX_TUNER ? ( val>=0.5 ? strcpy(out_str,"MUTED") : strcpy(out_str,"THRU"); )
  : fx_id==FX_BOOSTER && p_idx==0 ? sprintf(out_str,"+%.1f dB",val*20)
  : fx_id==FX_73DRIVE && p_idx==0 ? sprintf(out_str,"%.0f",val*100)  // DRIVE 0-100
  : fx_id==FX_73DRIVE && p_idx==3 ? sprintf(out_str,"%.0f",val*100)  // XFORMER 0-100
  : fx_id==FX_73DRIVE && p_idx==4 ? sprintf(out_str,"%.0f",val*100)  // SOFTCLIP 0-100
  : fx_id==FX_73DRIVE && p_idx==5 ? sprintf(out_str,"%+.1f dB",(val-0.5)*36)  // INPUT -18 to +18dB
  : fx_id==FX_DELAY && p_idx==0 ? sprintf(out_str,"%d ms",floor(40+val*1160))
  : fx_id==FX_ANALOG_DLY && p_idx==0 ? sprintf(out_str,"%d ms",floor(25+val*625))
  : fx_id==FX_TAPE_ECHO && p_idx==0 ? sprintf(out_str,"%d ms",floor(50+val*850))
  : fx_id==FX_SPACE_ECHO && p_idx==0 ? sprintf(out_str,"%d ms",floor(60+val*740))
  : (fx_id>=FX_REV_HALL && fx_id<=FX_REV_SHIMMER) && p_idx==1 ? sprintf(out_str,"%d ms",floor(2+val*120))
  : fx_id==FX_EQ5 ? sprintf(out_str,"%+.1f dB",(val-0.5)*24)
  : fx_id==FX_PARAEQ && p_idx==0 ? sprintf(out_str,"%.0f Hz",20*exp(val*log(400/20)))
  : fx_id==FX_PARAEQ && p_idx==1 ? sprintf(out_str,"%.1f kHz",(1500*exp(val*log(18000/1500)))*0.001)
  : fx_id==FX_PARAEQ && p_idx==3 ? sprintf(out_str,"%.0f Hz",220*exp(val*log(4800/220)))
  : fx_id==FX_PARAEQ && (p_idx==2 || p_idx==4 || p_idx==5) ? sprintf(out_str,"%+.1f dB",(val-0.5)*24)
  : (fx_id>=FX_CHORUS && fx_id<=FX_ROTARY) && p_idx==0 ? sprintf(out_str,"%.1f Hz",0.1+val*(fx_id==FX_TREMOLO?13.0:fx_id==FX_ROTARY?7.2:4.5))
  : fx_id==FX_COMP && p_idx==1 ? sprintf(out_str,"%.1f:1",1.5+val*10.5)
  : fx_id==FX_COMP && p_idx==0 ? sprintf(out_str,"%.0f dB",-38+(1-val)*34)
  : fx_id==FX_GATE && p_idx==0 ? sprintf(out_str,"%.0f dB",-72+val*52)
  : sprintf(out_str,"%.0f%%",val*100);
);

function get_note_name(midi_i, out_str) local(pc, oct) (
  pc=((midi_i%12)+12)%12; oct=floor(midi_i/12)-1;
  pc==0?sprintf(out_str,"C%d",oct):pc==1?sprintf(out_str,"C#%d",oct):pc==2?sprintf(out_str,"D%d",oct)
  :pc==3?sprintf(out_str,"D#%d",oct):pc==4?sprintf(out_str,"E%d",oct):pc==5?sprintf(out_str,"F%d",oct)
  :pc==6?sprintf(out_str,"F#%d",oct):pc==7?sprintf(out_str,"G%d",oct):pc==8?sprintf(out_str,"G#%d",oct)
  :pc==9?sprintf(out_str,"A%d",oct):pc==10?sprintf(out_str,"A#%d",oct):sprintf(out_str,"B%d",oct);
);

function get_preset_raw_name(idx, out_str) local(u, ubase, nlen, ni, ch) (
  u=clamp(idx,0,9); ubase=USER_PRESET_BASE+u*128;
  nlen=clamp(floor(ubase[96]), 0, 20);
  nlen > 0 ? (
    strcpy(out_str, "");
    ni=0; loop(nlen,
      ch=floor(ubase[97+ni]);
      (ch>=32 && ch<=126) ? str_setchar(out_str, ni, ch) : str_setchar(out_str, ni, 32);
      ni+=1;
    );
  ) : (
    sprintf(out_str, "USER BANK %d", u+1);
  );
);

function get_preset_name(idx, out_str) local(u) (
  u=clamp(idx,0,9);
  get_preset_raw_name(u, #tmp_raw_name);
  sprintf(out_str, "%02d: %s", u+1, #tmp_raw_name);
);

function set_preset_name(idx, in_str) local(u, ubase, nlen, ni) (
  u=clamp(idx,0,9); ubase=USER_PRESET_BASE+u*128;
  nlen=clamp(strlen(in_str), 0, 20);
  ubase[96]=nlen;
  ni=0; loop(20,
    ubase[97+ni] = ni<nlen ? str_getchar(in_str, ni) : 0;
    ni+=1;
  );
);

function open_rename_modal(idx, ret_menu) local(u, ubase, nlen) (
  rename_slot_idx=clamp(idx,0,9);
  rename_return_menu=ret_menu;
  u=rename_slot_idx; ubase=USER_PRESET_BASE+u*128;
  nlen=clamp(floor(ubase[96]), 0, 20);
  nlen > 0 ? get_preset_raw_name(u, #rename_buf) : strcpy(#rename_buf, "");
  while (gfx_getchar() > 0) ( 0; );
  ui_preset_menu=0; ui_modal_open=0; ui_rename_open=1;
);

function draw_centered_text(cx, cy, str, font_idx) local(tw, th) (
  gfx_setfont(font_idx); gfx_measurestr(str,tw,th); gfx_x=vx(cx)-tw*0.5; gfx_y=vy(cy)-th*0.5; gfx_drawstr(str);
);

function draw_slot_artwork(s, fx_id, x, y, w, h, active) local(cx, cy, cfg, a, i, ang, acR, acG, acB, bx, val, ky) (
  cx=x+w*0.5; cy=y+h*0.44; a=active?1.0:0.35; cfg=SLOT_CFG_BASE+s*SLOT_CFG_STRIDE;
  acR=0.25; acG=0.92; acB=1.0;
  fx_id==FX_COMP ? (acR=1.0; acG=0.35; acB=0.35;) : 0;
  fx_id==FX_GATE ? (acR=1.0; acG=0.62; acB=0.20;) : 0;
  fx_id==FX_AUTOWAH ? (acR=1.0; acG=0.25; acB=0.25;) : 0;
  fx_id==FX_CRYWAH ? (acR=1.0; acG=0.88; acB=0.20;) : 0;
  fx_id==FX_TUNER ? (acR=0.22; acG=1.0; acB=0.50;) : 0;
  fx_id==FX_BOOSTER ? (acR=0.95; acG=0.80; acB=0.35;) : 0;
  fx_id==FX_TS808 ? (acR=0.18; acG=0.95; acB=0.62;) : 0;
  fx_id==FX_KLON ? (acR=0.95; acG=0.80; acB=0.35;) : 0;
  fx_id==FX_BLUESDRV ? (acR=0.25; acG=0.68; acB=1.0;) : 0;
  fx_id==FX_SUPEROD ? (acR=1.0; acG=0.58; acB=0.22;) : 0;
  fx_id==FX_DIST ? (acR=1.0; acG=0.38; acB=0.35;) : 0;
  fx_id==FX_RAT ? (acR=1.0; acG=0.38; acB=0.35;) : 0;
  fx_id==FX_FUZZ ? (acR=0.72; acG=0.45; acB=1.0;) : 0;
  fx_id==FX_MUFF ? (acR=1.0; acG=0.38; acB=0.35;) : 0;
  fx_id==FX_73DRIVE ? (acR=0.98; acG=0.75; acB=0.25;) : 0;
  fx_id==FX_OCTAVER ? (acR=1.0; acG=0.25; acB=0.25;) : 0;
  fx_id==FX_AMP_FENDER ? (acR=0.30; acG=0.70; acB=1.0;) : 0;
  fx_id==FX_AMP_BASSMAN ? (acR=1.0; acG=0.62; acB=0.20;) : 0;
  fx_id==FX_AMP_TWEED ? (acR=1.0; acG=0.88; acB=0.20;) : 0;
  fx_id==FX_AMP_VOX ? (acR=0.45; acG=1.0; acB=0.45;) : 0;
  fx_id==FX_AMP_PLEXI ? (acR=1.0; acG=0.30; acB=0.30;) : 0;
  fx_id==FX_AMP_JCM800 ? (acR=0.82; acG=0.30; acB=1.0;) : 0;
  fx_id==FX_AMP_ORANGE ? (acR=1.0; acG=0.52; acB=0.12;) : 0;
  fx_id==FX_AMP_MESA ? (acR=1.0; acG=0.20; acB=0.22;) : 0;
  fx_id==FX_AMP_5150 ? (acR=0.92; acG=0.20; acB=0.92;) : 0;
  fx_id==FX_AMP_JC120 ? (acR=0.22; acG=0.62; acB=1.0;) : 0;
  fx_id==FX_CAB_112BF ? (acR=0.42; acG=0.52; acB=0.72;) : 0;
  fx_id==FX_CAB_212AC ? (acR=0.40; acG=0.50; acB=0.70;) : 0;
  fx_id==FX_CAB_410TW ? (acR=0.38; acG=0.48; acB=0.68;) : 0;
  fx_id==FX_CAB_412GB ? (acR=0.36; acG=0.46; acB=0.66;) : 0;
  fx_id==FX_CAB_412V30 ? (acR=0.34; acG=0.44; acB=0.64;) : 0;
  fx_id==FX_EQ5 ? (acR=0.32; acG=1.0; acB=0.55;) : 0;
  fx_id==FX_PARAEQ ? (acR=1.0; acG=0.92; acB=0.28;) : 0;
  fx_id==FX_CHORUS ? (acR=0.22; acG=0.52; acB=1.0;) : 0;
  fx_id==FX_FLANGER ? (acR=0.82; acG=0.30; acB=1.0;) : 0;
  fx_id==FX_PHASER ? (acR=0.32; acG=1.0; acB=0.82;) : 0;
  fx_id==FX_TREMOLO ? (acR=0.45; acG=1.0; acB=0.45;) : 0;
  fx_id==FX_ROTARY ? (acR=1.0; acG=0.62; acB=0.22;) : 0;
  fx_id==FX_DELAY ? (acR=1.0; acG=0.32; acB=0.32;) : 0;
  fx_id==FX_ANALOG_DLY ? (acR=1.0; acG=0.58; acB=0.22;) : 0;
  fx_id==FX_TAPE_ECHO ? (acR=1.0; acG=0.84; acB=0.24;) : 0;
  fx_id==FX_SPACE_ECHO ? (acR=0.92; acG=0.30; acB=1.0;) : 0;
  fx_id==FX_REV_HALL ? (acR=0.32; acG=1.0; acB=0.62;) : 0;
  fx_id==FX_REV_PLATE ? (acR=0.32; acG=0.72; acB=1.0;) : 0;
  fx_id==FX_REV_SPRING ? (acR=1.0; acG=0.62; acB=0.30;) : 0;
  fx_id==FX_REV_SHIMMER ? (acR=1.0; acG=0.42; acB=0.82;) : 0;

  fx_id==FX_TUNER ? (
    active ? draw_soft_halo(cx,y+40,6,15,acR,acG,acB,0.65);
    gfx_set(acR,acG,acB,0.85*a); gfx_arc(vx(cx),vy(y+54),vs(24),-1.1,1.1,1);
    gfx_line(vx(cx),vy(y+54),vx(cx),vy(y+26)); gfx_circle(vx(cx),vy(y+54),vs(3.5),1,1);
    gfx_set(acR,acG,acB,0.95*a); gfx_circle(vx(cx),vy(y+24),vs(3.0),1,1);
  ) : ((fx_id>=FX_AUTOWAH && fx_id<=FX_CRYWAH) || (fx_id>=FX_BOOSTER && fx_id<=FX_73DRIVE)) ? (
    i=-1; loop(3, gfx_set(0.06,0.12,0.16,0.9); gfx_circle(vx(cx+i*19),vy(y+18),vs(6.5),1,1);
      gfx_set(acR,acG,acB,0.75*a); gfx_circle(vx(cx+i*19),vy(y+18),vs(6.5),0,1);
      gfx_line(vx(cx+i*19),vy(y+18),vx(cx+i*19+3),vy(y+14)); i+=1; );
    active ? draw_soft_halo(cx,y+49,3,14,acR,acG,acB,0.75);
    gfx_set(acR,acG,acB,0.9*a); gfx_circle(vx(cx),vy(y+49),vs(9),0,1); gfx_circle(vx(cx),vy(y+49),vs(4),1,1);
  ) : (fx_id>=FX_CHORUS && fx_id<=FX_ROTARY) ? (
    i=-1; loop(2, gfx_set(0.06,0.12,0.16,0.9); gfx_circle(vx(cx+i*18),vy(y+16),vs(5.5),1,1);
      gfx_set(acR,acG,acB,0.75*a); gfx_circle(vx(cx+i*18),vy(y+16),vs(5.5),0,1); i+=2; );
    active ? draw_soft_halo(cx,y+47,3,16,acR,acG,acB,0.75);
    gfx_set(acR,acG,acB,0.92*a); gfx_arc(vx(cx),vy(y+47),vs(13),0.2,4.2,1); gfx_arc(vx(cx),vy(y+47),vs(8),2.5,6.0,1); gfx_circle(vx(cx),vy(y+47),vs(3),1,1);
  ) : (fx_id==FX_COMP || fx_id==FX_GATE) ? (
    i=-1; loop(2, gfx_set(acR,acG,acB,0.75*a); gfx_circle(vx(cx+i*19),vy(y+17),vs(5.5),0,1); i+=2; );
    active ? draw_soft_halo(cx,y+37,2,11,acR,acG,acB,0.55);
    gfx_set(0.12,0.35,0.45,0.7); gfx_rect(vx(cx-1.5),vy(y+26),vs(3),vs(26));
    gfx_set(acR,acG,acB,0.9*a); gfx_rect(vx(cx-5),vy(y+35),vs(10),vs(4)); gfx_circle(vx(cx),vy(y+57),vs(7),0,1);
  ) : fx_id==FX_EQ5 ? (
    i=0; loop(5, bx=cx-26+i*13; gfx_set(0.12,0.35,0.44,0.65); gfx_rect(vx(bx-1),vy(y+18),vs(2),vs(42));
      val=cfg[2+i]; ky=y+18+(1-val)*38; active?draw_soft_halo(bx,ky+2,1.5,6,acR,acG,acB,0.65);
      gfx_set(acR,acG,acB,0.95*a); gfx_circle(vx(bx),vy(ky+2),vs(3.5),1,1); i+=1; );
  ) : fx_id==FX_PARAEQ ? (
    gfx_set(0.15,0.42,0.52,0.7); gfx_line(vx(x+14),vy(y+42),vx(x+w-14),vy(y+42));
    active ? draw_soft_halo(cx,y+40,4,16,acR,acG,acB,0.55);
    gfx_set(acR,acG,acB,0.92*a);
    gfx_line(vx(x+16),vy(y+56),vx(x+30),vy(y+34)); gfx_line(vx(x+30),vy(y+34),vx(cx),vy(y+24));
    gfx_line(vx(cx),vy(y+24),vx(x+w-30),vy(y+34)); gfx_line(vx(x+w-30),vy(y+34),vx(x+w-16),vy(y+56));
  ) : (fx_id>=FX_AMP_FENDER && fx_id<=FX_AMP_JC120) ? (
    gfx_set(0.05,0.11,0.15,0.95); fill_rrect(x+12,y+12,w-24,52,4);
    gfx_set(acR,acG,acB,0.65*a); stroke_rrect(x+12,y+12,w-24,52,4);
    gfx_set(0.14,0.45,0.56,0.45*a); i=0; loop(5, gfx_line(vx(x+16),vy(y+18+i*5),vx(x+w-16),vy(y+18+i*5)); i+=1; );
    active ? draw_soft_rrect_bloom(cx-28,y+40,56,16,3,5,acR,acG,acB,0.65);
    gfx_set(0.06,0.16,0.22,0.95); fill_rrect(cx-28,y+40,56,16,3);
    gfx_set(acR,acG,acB,0.95*a); stroke_rrect(cx-28,y+40,56,16,3);
    gfx_set(acR,acG,acB,0.95*a);
    draw_centered_text(cx,y+48,fx_id==FX_AMP_FENDER?"FENDER":fx_id==FX_AMP_BASSMAN?"BASSMAN":fx_id==FX_AMP_TWEED?"TWEED"
      :fx_id==FX_AMP_VOX?"VOX AC":fx_id==FX_AMP_PLEXI?"PLEXI":fx_id==FX_AMP_JCM800?"JCM800":fx_id==FX_AMP_ORANGE?"ORANGE"
      :fx_id==FX_AMP_MESA?"MESA":fx_id==FX_AMP_5150?"5150":"JC-120",4);
  ) : (fx_id>=FX_CAB_112BF && fx_id<=FX_CAB_412V30) ? (
    gfx_set(0.05,0.08,0.11,0.95); fill_rrect(x+14,y+11,w-28,54,4);
    gfx_set(acR,acG,acB,0.5*a); stroke_rrect(x+14,y+11,w-28,54,4);
    active ? draw_soft_halo(cx,y+38,8,14,acR,acG,acB,0.45);
    gfx_set(0.18,0.28,0.34,0.95); gfx_circle(vx(cx),vy(y+38),vs(21),1,1);
    gfx_set(0.08,0.13,0.17,0.98); gfx_circle(vx(cx),vy(y+38),vs(17),1,1);
    gfx_set(acR,acG,acB,0.75*a); gfx_circle(vx(cx),vy(y+38),vs(21),0,1); gfx_circle(vx(cx),vy(y+38),vs(7),1,1);
    gfx_set(0.05,0.12,0.16,0.9); gfx_circle(vx(cx),vy(y+38),vs(5.5),1,1);
  ) : (fx_id>=FX_DELAY && fx_id<=FX_SPACE_ECHO) ? (
    active ? draw_soft_halo(cx,y+40,5,16,acR,acG,acB,0.65);
    gfx_set(acR,acG,acB,0.92*a); gfx_arc(vx(cx),vy(y+40),vs(18),-2.2,2.2,1); gfx_arc(vx(cx),vy(y+40),vs(16),-2.2,1.2,1);
    ang=-1.6+cfg[2]*3.2; gfx_line(vx(cx),vy(y+40),vx(cx+sin(ang)*14),vy(y+40-cos(ang)*14),1); gfx_circle(vx(cx),vy(y+40),vs(3.5),1,1);
    (fx_id==FX_TAPE_ECHO||fx_id==FX_SPACE_ECHO)?( gfx_circle(vx(cx-12),vy(y+58),vs(4.5),0,1); gfx_circle(vx(cx+12),vy(y+58),vs(4.5),0,1); );
  ) : (
    active ? draw_soft_halo(cx,y+39,5,16,acR,acG,acB,0.70);
    gfx_set(acR,acG,acB,0.95*a); gfx_circle(vx(cx),vy(y+39),vs(17),1,1);
    gfx_set(0.07,0.12,0.16,1.0); gfx_circle(vx(cx+6.5),vy(y+38),vs(13.5),1,1);
    gfx_set(acR,acG,acB,0.55*a); gfx_arc(vx(cx),vy(y+39),vs(21),0.3,4.5,1);
  );
);

function draw_neon_knob(cx, cy, r, val, label, val_txt, is_active) local(ang_min, ang_max, ang, px, py, step, d_v, d_px, g, tube, core, rc, gc, bc, rr, shade, r_cap, r_ring, t, xs, ys, xe, ye, ccx, ccy, rr_px) (
  ang_min=-2.356; ang_max=2.356; ang=ang_min+val*(ang_max-ang_min);
  r_ring=r+5.5; r_cap=r-5.5; ccx=vx(cx); ccy=vy(cy); rr_px=vs(r_ring);
  gfx_set(0.78,0.96,1.0,is_active?0.96:0.45); draw_centered_text(cx,cy-r-28,label,2);

  is_active ? (
    xs=vx(cx+sin(ang_min)*r_ring); ys=vy(cy-cos(ang_min)*r_ring);
    xe=vx(cx+sin(ang)*r_ring); ye=vy(cy-cos(ang)*r_ring);
    step=0;
    loop(28,
      d_v=(41-step)*0.34; g=exp(-(d_v*d_v)/(2.0*4.2*4.2));
      gfx_set(clamp(0.05+0.06*g,0,1), clamp(0.08+0.46*g,0,1), clamp(0.11+0.54*g,0,1), 1.0);
      d_px=vs(d_v); gfx_circle(xs,ys,max(1.0,d_px),1,1); gfx_circle(xe,ye,max(1.0,d_px),1,1);
      gfx_arc(ccx,ccy,max(1.0,rr_px-d_px),ang_min,ang,1); gfx_arc(ccx,ccy,rr_px+d_px,ang_min,ang,1); step+=1;
    );
    ang < ang_max-0.01 ? (
      gfx_set(0.12,0.28,0.36,0.92);
      gfx_arc(ccx,ccy,rr_px-vs(0.45),ang,ang_max,1); gfx_arc(ccx,ccy,rr_px,ang,ang_max,1); gfx_arc(ccx,ccy,rr_px+vs(0.45),ang,ang_max,1);
    );
    step=28;
    loop(14,
      d_v=(41-step)*0.34; g=exp(-(d_v*d_v)/(2.0*4.2*4.2));
      tube=exp(-sqr(max(0,d_v-0.8))/0.85); core=exp(-(d_v*d_v)/0.45);
      gfx_set(clamp(0.05+0.06*g+0.25*tube+0.55*core,0,1), clamp(0.08+0.46*g+0.48*tube+0.10*core,0,1), clamp(0.11+0.54*g+0.40*tube+0.02*core,0,1), 1.0);
      d_px=vs(d_v); gfx_circle(xs,ys,max(1.0,d_px),1,1); gfx_circle(xe,ye,max(1.0,d_px),1,1);
      gfx_arc(ccx,ccy,max(1.0,rr_px-d_px),ang_min,ang,1); gfx_arc(ccx,ccy,rr_px+d_px,ang_min,ang,1); step+=1;
    );
  ) : (
    gfx_set(0.12,0.26,0.34,0.70); gfx_arc(ccx,ccy,rr_px,ang_min,ang_max,1);
    val>0.005 ? ( gfx_set(0.22,0.45,0.55,0.85); gfx_arc(ccx,ccy,rr_px-vs(0.5),ang_min,ang,1); gfx_arc(ccx,ccy,rr_px+vs(0.5),ang_min,ang,1); );
  );

  gfx_set(0.03,0.06,0.08,0.98); gfx_circle(ccx,ccy,vs(r_cap+2.2),1,1);
  step=0; loop(10, t=step/9; rr=r_cap*(1.0-t*0.68); shade=0.09+t*0.13;
    gfx_set(shade*0.85,shade*1.05,shade*1.25,1.0); gfx_circle(ccx,vy(cy-t*1.2),vs(rr),1,1); step+=1; );
  gfx_set(0.07,0.10,0.13,1.0); gfx_circle(ccx,ccy,vs(r_cap*0.48),1,1);
  gfx_set(0.32,0.86,0.98,is_active?0.42:0.18); gfx_circle(ccx,ccy,vs(r_cap),0,1);

  px=cx+sin(ang)*(r_cap-3.5); py=cy-cos(ang)*(r_cap-3.5);
  is_active ? draw_soft_halo(px,py,1,7,0.32,0.95,1.0,0.85);
  gfx_set(0.88,1.0,1.0,is_active?1.0:0.55);
  gfx_line(vx(cx+sin(ang)*(r_cap*0.32)),vy(cy-cos(ang)*(r_cap*0.32)),vx(px),vy(py),1);
  gfx_circle(vx(px),vy(py),vs(2.0),1,1);
  gfx_set(0.68,0.94,1.0,is_active?0.95:0.45); draw_centered_text(cx,cy+r+26,val_txt,3);
);

function draw_io_mini(x, y, label, norm_val, meter_lin) local(ang, cx, cy, r, lvl, seg, i) (
  cx=x+16; cy=y+18; r=10; ang=-2.356+norm_val*4.712;
  draw_soft_halo(cx,cy,r-2,7,0.15,0.88,1.0,0.45);
  gfx_set(0.10,0.15,0.20,1.0); gfx_circle(vx(cx),vy(cy),vs(r),1,1);
  gfx_set(0.18,0.45,0.56,0.65); gfx_circle(vx(cx),vy(cy),vs(r+1.5),0,1);
  gfx_set(0.32,0.95,1.0,0.95); norm_val>0.005?gfx_arc(vx(cx),vy(cy),vs(r+1.5),-2.356,ang,1);
  gfx_line(vx(cx),vy(cy),vx(cx+sin(ang)*7.5),vy(cy-cos(ang)*7.5),1);
  gfx_set(0.80,0.95,1.0,0.95); draw_centered_text(x+56,y+11,label,4);
  lvl=clamp(meter_lin*1.4,0,1); gfx_set(0.05,0.08,0.11,1.0); gfx_rect(vx(x+33),vy(y+19),vs(54),vs(8));
  i=0; loop(10, seg=(i+1)/10;
    lvl>=seg*0.85 ? ( i>=8?gfx_set(1.0,0.35,0.30,0.95):gfx_set(0.25,0.96,1.0,0.95); ) : gfx_set(0.12,0.28,0.36,0.55);
    gfx_rect(vx(x+34.5+i*5.2),vy(y+20.5),vs(3.8),vs(5)); i+=1; );
);

gfx_clear = -1;

(gfx_w > 0 && gfx_h > 0) ? (
  ui_w=gfx_w; ui_h=gfx_h; sc=min(ui_w/960,ui_h/600);
  ox=(ui_w-960*sc)*0.5; oy=(ui_h-600*sc)*0.5;
  mx=(mouse_x-ox)/sc; my=(mouse_y-oy)/sc;

  (ui_w!=prev_gfx_w || ui_h!=prev_gfx_h) ? (
    prev_gfx_w=ui_w; prev_gfx_h=ui_h; gfx_setimgdim(0,ui_w,ui_h);
    gfx_setfont(1,"Arial",max(10,floor(15*sc)),'b');
    gfx_setfont(2,"Arial",max(9,floor(12*sc)),'b');
    gfx_setfont(3,"Arial",max(8,floor(10.5*sc)),0);
    gfx_setfont(4,"Arial",max(8,floor(9.5*sc)),'b');
    gfx_setfont(5,"Arial",max(18,floor(32*sc)),'b');
    gfx_setfont(6,"Arial",max(16,floor(28*sc)),'b');
  );

  gfx_dest=0; gfx_mode=0;
  gfx_set(0.03,0.05,0.07,1.0); gfx_rect(0,0,ui_w,ui_h);
  gfx_set(0.08,0.11,0.14,1.0); fill_rrect(4,4,952,592,8);
  gfx_set(0.18,0.42,0.52,0.55); stroke_rrect(4,4,952,592,8);

  // TOP BAR
  gfx_set(0.07,0.10,0.13,1.0); fill_rrect(6,6,948,36,6);
  gfx_set(0.14,0.35,0.44,0.45); gfx_line(vx(6),vy(42),vx(954),vy(42));

  // TRON BOARD (IZQUIERDA)
  gfx_setfont(1); gfx_measurestr("TRON BOARD",tr_w,tr_h);
  draw_soft_halo(20+(tr_w/sc)*0.5,24,4,32,0.10,0.85,1.0,0.35);
  gfx_set(0.45,0.97,1.0,1.0); gfx_x=vx(20); gfx_y=vy(24)-tr_h*0.5; gfx_drawstr("TRON BOARD");

  // BTONE LOGO CON DISCO DE IDENTIDAD DE TRON EN LA "O" (CENTRO)
  gfx_setfont(6);
  gfx_measurestr("BT", bt_lw, bt_lh);
  gfx_measurestr("NE", ne_lw, ne_lh);
  bt_lw_v = bt_lw / sc;
  ne_lw_v = ne_lw / sc;
  disc_r = 11.5;
  disc_gap = 2.2;
  bt_tot_v = bt_lw_v + disc_gap + disc_r*2 + disc_gap + ne_lw_v;
  bt_start_v = 480 - bt_tot_v * 0.5;
  disc_cx = bt_start_v + bt_lw_v + disc_gap + disc_r;
  ne_start_v = disc_cx + disc_r + disc_gap;

  draw_soft_halo(bt_start_v + bt_lw_v*0.5, 24, 4, 24, 1.0, 0.45, 0.04, 0.45);
  draw_soft_halo(ne_start_v + ne_lw_v*0.5, 24, 4, 24, 1.0, 0.45, 0.04, 0.45);

  bt_x1 = vx(bt_start_v); bt_y1 = vy(24) - bt_lh*0.5;
  bt_x2 = vx(ne_start_v); bt_y2 = vy(24) - ne_lh*0.5;

  gfx_mode=1;
  gfx_set(1.0,0.48,0.04,0.28);
  gfx_x=bt_x1-vs(1.2); gfx_y=bt_y1; gfx_drawstr("BT");
  gfx_x=bt_x1+vs(1.2); gfx_y=bt_y1; gfx_drawstr("BT");
  gfx_x=bt_x1; gfx_y=bt_y1-vs(1.2); gfx_drawstr("BT");
  gfx_x=bt_x1; gfx_y=bt_y1+vs(1.2); gfx_drawstr("BT");
  gfx_x=bt_x2-vs(1.2); gfx_y=bt_y2; gfx_drawstr("NE");
  gfx_x=bt_x2+vs(1.2); gfx_y=bt_y2; gfx_drawstr("NE");
  gfx_x=bt_x2; gfx_y=bt_y2-vs(1.2); gfx_drawstr("NE");
  gfx_x=bt_x2; gfx_y=bt_y2+vs(1.2); gfx_drawstr("NE");
  gfx_mode=0;
  gfx_set(1.0,0.82,0.18,1.0);
  gfx_x=bt_x1; gfx_y=bt_y1; gfx_drawstr("BT");
  gfx_x=bt_x2; gfx_y=bt_y2; gfx_drawstr("NE");
  gfx_mode=1;
  gfx_set(1.0,0.95,0.55,0.32);
  gfx_x=bt_x1; gfx_y=bt_y1; gfx_drawstr("BT");
  gfx_x=bt_x2; gfx_y=bt_y2; gfx_drawstr("NE");
  gfx_mode=0;

  draw_tron_disc(disc_cx, 24, disc_r);

  draw_io_mini(715,6,"INPUT",in_gain_norm,max(meter_in_L,meter_in_R));
  draw_io_mini(825,6,"OUTPUT",out_gain_norm,max(meter_out_L,meter_out_R));

  // PEDALBOARD GRID
  gfx_set(0.04,0.07,0.10,1.0); gfx_rect(vx(8),vy(44),vs(944),vs(272));
  gfx_set(0.09,0.26,0.34,0.25);
  ui_i=0; loop(18, gfx_line(vx(12+ui_i*54),vy(44),vx(12+ui_i*54),vy(316)); ui_i+=1; );
  ui_i=0; loop(6, gfx_line(vx(8),vy(52+ui_i*48),vx(952),vy(52+ui_i*48)); ui_i+=1; );
  gfx_set(0.12,0.45,0.58,0.35);
  gfx_line(vx(620),vy(56),vx(740),vy(56)); gfx_line(vx(740),vy(56),vx(770),vy(86)); gfx_circle(vx(770),vy(86),vs(2.5),1,1);
  gfx_line(vx(820),vy(110),vx(905),vy(110)); gfx_line(vx(905),vy(110),vx(925),vy(140)); gfx_circle(vx(820),vy(110),vs(2.5),1,1);

  gfx_set(0.35,0.85,0.98,0.85); draw_centered_text(34,112,"ROW 1",2); draw_centered_text(34,240,"ROW 2",2);
  gfx_set(0.30,0.72,0.85,0.65); draw_centered_text(34,256,"(POST)",3);

  slot_w=116; slot_h=104; gap_x=18; start_x=86; row1_y=60; row2_y=194;
  r1_cy=row1_y+slot_h*0.5; r2_cy=row2_y+slot_h*0.5; mid_bus_y=179;
  bus_on=slider3<0.5?1:0; r1_end_x=start_x+5*(slot_w+gap_x)+slot_w; turn_r_x=r1_end_x+26; turn_l_x=start_x-16;

  bus_on ? (
    draw_neon_line_bloom(62,r1_cy,start_x,r1_cy);
    ui_i=0; loop(5, ui_xA=start_x+ui_i*(slot_w+gap_x)+slot_w; draw_neon_line_bloom(ui_xA,r1_cy,ui_xA+gap_x,r1_cy); ui_i+=1; );
    draw_neon_line_bloom(r1_end_x,r1_cy,turn_r_x,r1_cy); draw_neon_line_bloom(turn_r_x,r1_cy+3,turn_r_x,mid_bus_y-3);
    draw_neon_line_bloom(turn_r_x,mid_bus_y,turn_l_x,mid_bus_y); draw_neon_line_bloom(turn_l_x,mid_bus_y+3,turn_l_x,r2_cy-3);
    draw_neon_line_bloom(turn_l_x,r2_cy,start_x,r2_cy);
    ui_i=0; loop(5, ui_xA=start_x+ui_i*(slot_w+gap_x)+slot_w; draw_neon_line_bloom(ui_xA,r2_cy,ui_xA+gap_x,r2_cy); ui_i+=1; );
    draw_neon_line_bloom(r1_end_x,r2_cy,r1_end_x+24,r2_cy);
  );
  draw_neon_line_core(62,r1_cy,start_x,r1_cy,bus_on);
  ui_i=0; loop(5, ui_xA=start_x+ui_i*(slot_w+gap_x)+slot_w; draw_neon_line_core(ui_xA,r1_cy,ui_xA+gap_x,r1_cy,bus_on); ui_i+=1; );
  draw_neon_line_core(r1_end_x,r1_cy,turn_r_x,r1_cy,bus_on); draw_neon_line_core(turn_r_x,r1_cy,turn_r_x,mid_bus_y,bus_on);
  draw_neon_line_core(turn_r_x,mid_bus_y,turn_l_x,mid_bus_y,bus_on); draw_neon_line_core(turn_l_x,mid_bus_y,turn_l_x,r2_cy,bus_on);
  draw_neon_line_core(turn_l_x,r2_cy,start_x,r2_cy,bus_on);
  ui_i=0; loop(5, ui_xA=start_x+ui_i*(slot_w+gap_x)+slot_w; draw_neon_line_core(ui_xA,r2_cy,ui_xA+gap_x,r2_cy,bus_on); ui_i+=1; );
  draw_neon_line_core(r1_end_x,r2_cy,r1_end_x+24,r2_cy,bus_on);
  gfx_set(0.35,0.90,1.0,0.85); draw_centered_text(924,r2_cy,"OUT",4);

  ui_s=0;
  loop(12,
    ui_row=ui_s<6?0:1; ui_col=ui_s%6; ui_sx=start_x+ui_col*(slot_w+gap_x); ui_sy=ui_row==0?row1_y:row2_y;
    ui_cfg=SLOT_CFG_BASE+ui_s*SLOT_CFG_STRIDE; ui_fx=ui_cfg[0]; ui_byp=ui_cfg[1]; ui_sel=(ui_s==sel_slot); ui_act=(ui_fx>0&&ui_byp==0);
    ui_sel ? draw_soft_rrect_bloom(ui_sx,ui_sy,slot_w,slot_h,7,13,0.14,0.90,1.0,0.85)
    : ui_act ? draw_soft_rrect_bloom(ui_sx,ui_sy,slot_w,slot_h,7,7,0.08,0.72,0.92,0.30);
    gfx_set(0,0,0,0.58); fill_rrect(ui_sx+2,ui_sy+4,slot_w,slot_h,7);
    ui_fx==FX_EMPTY?gfx_set(0.05,0.08,0.11,0.94):gfx_set(0.07,0.12,0.16,0.98); fill_rrect(ui_sx,ui_sy,slot_w,slot_h,7);
    ui_sel?gfx_set(0.55,0.99,1.0,0.98):ui_act?gfx_set(0.22,0.82,0.96,0.75):gfx_set(0.16,0.28,0.36,0.55); stroke_rrect(ui_sx,ui_sy,slot_w,slot_h,7);
    ui_fx==FX_EMPTY ? (
      gfx_set(0.10,0.18,0.24,0.9); gfx_circle(vx(ui_sx+slot_w*0.5),vy(ui_sy+42),vs(15),1,1);
      gfx_set(0.22,0.65,0.78,0.65); gfx_circle(vx(ui_sx+slot_w*0.5),vy(ui_sy+42),vs(15),0,1);
      gfx_line(vx(ui_sx+slot_w*0.5-6),vy(ui_sy+42),vx(ui_sx+slot_w*0.5+6),vy(ui_sy+42));
      gfx_line(vx(ui_sx+slot_w*0.5),vy(ui_sy+36),vx(ui_sx+slot_w*0.5),vy(ui_sy+48));
      gfx_set(0.45,0.68,0.78,0.7); draw_centered_text(ui_sx+slot_w*0.5,ui_sy+86,"EMPTY SLOT",4);
    ) : (
      draw_slot_artwork(ui_s,ui_fx,ui_sx,ui_sy,slot_w,slot_h,ui_act);
      gfx_set(0.04,0.08,0.11,0.88); fill_rrect(ui_sx+4,ui_sy+77,slot_w-8,22,4);
      get_fx_short_name(ui_fx,#fx_lbl); gfx_set(ui_act?0.84:0.45,ui_act?0.97:0.55,ui_act?1.0:0.62,1.0);
      draw_centered_text(ui_sx+slot_w*0.5,ui_sy+88,#fx_lbl,4);
      ui_act ? draw_glow_circle(ui_sx+slot_w-10,ui_sy+10,2.8,0.22,0.96,1.0,0.92)
      : ( gfx_set(0.25,0.30,0.34,0.8); gfx_circle(vx(ui_sx+slot_w-10),vy(ui_sy+10),vs(2.8),1,1); );
    );
    ui_s+=1;
  );

  // INSPECTOR DIVIDER
  gfx_set(0.08,0.12,0.15,1.0); gfx_rect(vx(6),vy(316),vs(948),vs(28));
  gfx_set(0.18,0.45,0.56,0.55); gfx_line(vx(6),vy(316),vx(954),vy(316)); gfx_line(vx(6),vy(344),vx(954),vy(344));
  ui_cfg_sel=SLOT_CFG_BASE+sel_slot*SLOT_CFG_STRIDE; ui_sel_fx=ui_cfg_sel[0]; ui_sel_byp=ui_cfg_sel[1];
  get_fx_short_name(ui_sel_fx,#sel_name); sprintf(#insp_hdr,"SLOT %02d  |  %s",sel_slot+1,#sel_name);
  gfx_set(0.35,0.92,1.0,0.90); gfx_setfont(4); gfx_x=vx(20); gfx_y=vy(323); gfx_drawstr(#insp_hdr);
  gfx_set(0.75,0.88,0.94,0.85); draw_centered_text(480,330,"Control Panel Inspector",2);
  ui_act_x=690; ui_i=0;
  loop(4,
    ui_bw=ui_i<2?32:ui_i==2?90:76; ui_hov=hit_rect(ui_act_x,320,ui_bw,20);
    ui_hov?draw_soft_rrect_bloom(ui_act_x,320,ui_bw,20,3,4,0.18,0.90,1.0,0.55);
    gfx_set(ui_hov?0.15:0.09,ui_hov?0.28:0.15,ui_hov?0.36:0.20,1.0); fill_rrect(ui_act_x,320,ui_bw,20,3);
    gfx_set(0.25,0.85,1.0,ui_hov?0.9:0.42); stroke_rrect(ui_act_x,320,ui_bw,20,3);
